,"                  max_epochs=500, min_epochs=100, patience=50, seed=7325111, num_workers=4)\n","SPLIT_SEED = 7325111\n","os.makedirs(OUT_ROOT, exist_ok=True)\n","SESSION_BUDGET_SECONDS = 9 * 60 * 60\n","SESSION_DEADLINE = time.time() + SESSION_BUDGET_SECONDS\n"]},{"cell_type":"markdown","id":"6fc154ef","metadata":{"papermill":{"duration":0.003525,"end_time":"2026-11-21T22:25:47.048025+00:00","exception":false,"start_time":"2026-11-21T22:25:47.0445+00:00","status":"completed"},"tags":[]},"source":["## 6. Helper functions"]},{"cell_type":"code","execution_count":13,"id":"f0282850","metadata":{"execution":{"iopub.execute_input":"2026-11-21T22:25:47.056087Z","iopub.status.busy":"2026-11-21T22:25:47.055768Z","iopub.status.idle":"2026-11-21T22:25:47.09531Z","shell.execute_reply":"2026-11-21T22:25:47.094632Z"},"papermill":{"duration":0.045651,"end_time":"2026-11-21T22:25:47.096971+00:00","exception":false,"start_time":"2026-11-21T22:25:47.05132+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["norm = lambda s: re.sub(r\"[^a-z0-9]\", \"\", str(s).lower())\n","LABEL_CAND = [\"clustername\",\"nativelabel\",\"celltype\",\"celltypename\",\"cellphenotype\",\"phenotype\",\"cellannotation\",\"annotation\",\"cellclass\",\n","              \"majorcelltype\",\"celltypemajor\",\"metacluster\",\"cellmetacluster\",\"cluster\",\"clusters\",\"label\",\"labels\",\"cellsubtype\"]\n","GROUP_CAND = [\"patientid\",\"patient\",\"patients\",\"donor\",\"donorid\",\"subject\",\"subjectid\",\"caseid\",\"case\",\"sampleid\",\"sample\",\n","              \"samplename\",\"slideid\",\"slide\",\"imageid\",\"image\",\"imagenumber\",\"roi\",\"roiid\",\"region\",\"regionid\",\"spots\",\"spot\",\n","              \"fov\",\"tissueid\",\"tissue\",\"core\"]\n","AREA_CAND  = [\"cellsize\",\"area\",\"cellarea\",\"size\",\"nucleusarea\",\"nucleussize\",\"areapx\",\"areapx2\"]\n","NONMARKER_RE = re.compile(r\"(^|[^a-z])(x|y|z)([^a-z]|$)|centroid|coord|^index$|cell.?id|^id$|object.?id|label|fov|region|\"\n","                          r\"sample|patient|image|slide|core|roi|eccentric|solidity|perimeter|orientation|axis|extent|\"\n","                          r\"neighbo|cluster|annot|type|phenotype|tissue|donor|case|batch|unnamed|spot|tile|^__\", re.I)\n","EXTS = (\".csv\", \".tsv\", \".csv.gz\", \".tsv.gz\", \".parquet\", \".h5ad\")\n","\n","# ---- authors' own mapping for the Schurch CRC CODEX table (copied from scripts/MAPS/data_preprocessing/CRC_CODEX.py) ----\n","CRC_CLASS_MAPPING = {'B cells': 'B cells', 'CD11b+CD68+ macrophages': 'Macrophages', 'CD11c+ DCs': 'CD11c+ DCs',\n","    'CD163+ macrophages': 'Macrophages', 'CD4+ T cells': 'CD4+ T cells', 'CD4+ T cells CD45RO+': 'CD4+ T cells',\n","    'CD4+ T cells GATA3+': 'CD4+ T cells', 'CD68+ macrophages': 'Macrophages', 'CD68+ macrophages GzmB+': 'Macrophages',\n","    'CD68+CD163+ macrophages': 'Macrophages', 'CD8+ T cells': 'CD8+ T cells', 'NK cells': 'NK cells', 'Tregs': 'Tregs',\n","    'granulocytes': 'Granulocytes', 'immune cells': 'Immune cells', 'plasma cells': 'Plasma cells',\n","    'smooth muscle': 'Smooth muscle', 'stroma': 'Stroma', 'tumor cells': 'Tumor cells', 'vasculature': 'Vasculature'}\n","CRC_MARKERS = [\"aSMA - smooth muscle:Cyc_11_ch_2\",\"beta-catenin - Wnt signaling:Cyc_4_ch_4\",\"CD11b - macrophages:Cyc_10_ch_3\",\n"," \"CD11c - DCs:Cyc_12_ch_3\",\"CD138 - plasma cells:Cyc_21_ch_3\",\"CD15 - granulocytes:Cyc_14_ch_2\",\"CD163 - macrophages:Cyc_17_ch_3\",\n"," \"CD20 - B cells:Cyc_8_ch_3\",\"CD21 - DCs:Cyc_6_ch_4\",\"CD3 - T cells:Cyc_16_ch_4\",\"CD31 - vasculature:Cyc_19_ch_3\",\n"," \"CD34 - vasculature:Cyc_20_ch_3\",\"CD38 - multifunctional:Cyc_20_ch_4\",\"CD4 - T helper cells:Cyc_6_ch_3\",\"CD44 - stroma:Cyc_2_ch_2\",\n"," \"CD45 - hematopoietic cells:Cyc_4_ch_2\",\"CD45RA - naive T cells:Cyc_6_ch_2\",\"CD45RO - memory cells:Cyc_18_ch_3\",\n"," \"CD56 - NK cells:Cyc_10_ch_4\",\"CD68 - macrophages:Cyc_18_ch_4\",\"CD7 - T cells:Cyc_16_ch_3\",\"CD8 - cytotoxic T cells:Cyc_3_ch_2\",\n"," \"Chromogranin A - neuroendocrine:Cyc_17_ch_2\",\"Cytokeratin - epithelia:Cyc_10_ch_2\",\"FOXP3 - regulatory T cells:Cyc_2_ch_3\",\n"," \"GATA3 - Th2 helper T cells:Cyc_3_ch_4\",\"GFAP - nerves:Cyc_16_ch_2\",\"Granzyme B - cytotoxicity:Cyc_13_ch_2\",\n"," \"HLA-DR - MHC-II:Cyc_5_ch_2\",\"MUC-1 - epithelia:Cyc_7_ch_2\",\"Na-K-ATPase - membranes:Cyc_9_ch_2\",\n"," \"p53 - tumor suppressor:Cyc_3_ch_3\",\"Podoplanin - lymphatics:Cyc_19_ch_4\",\"Synaptophysin - neuroendocrine:Cyc_15_ch_3\"]\n","SORIN_MARKERS = [\"CD117\", \"CD11c\", \"CD14\", \"CD163\", \"CD16\", \"CD20\", \"CD31\", \"CD3\", \"CD4\",\n","                 \"CD68\", \"CD8a\", \"CD94\", \"DNA1\", \"FoxP3\", \"HLA-DR\", \"MPO\", \"Pancytokeratin\", \"TTF1\"]\n","PRESETS = {\"authors_CRC_CODEX\": dict(label_col=\"ClusterName\", group_col=\"spots\", area_col=False, marker_cols=CRC_MARKERS,\n","                                     class_mapping=CRC_CLASS_MAPPING, drop_unmapped=True),\n","           \"Sorin\": dict(label_col=\"native_label\", group_col=\"patient_id\", area_col=\"area_px2\", marker_cols=SORIN_MARKERS)}\n","\n","def find_col(df, cands, exclude=()):\n","    m = {norm(c): c for c in df.columns}\n","    for c in cands:\n","        if c in m and m[c] not in exclude: return m[c]\n","    return None\n","\n","def list_files(path):\n","    paths = path if isinstance(path, (list, tuple)) else [path]\n","    files = []\n","    for p in paths:\n","        if os.path.isdir(p): files += [f for f in glob.glob(os.path.join(p, \"**\", \"*\"), recursive=True) if f.lower().endswith(EXTS)]\n","        else: files += glob.glob(p, recursive=True)\n","    files = sorted(set(files))\n","    if not files: raise FileNotFoundError(f\"No data files found for: {path}\")\n","    return files\n","\n","def read_one(f, nrows=None):\n","    fl = f.lower()\n","    if fl.endswith(\".h5ad\"):\n","        a = anndata.read_h5ad(f)\n","        X = a.X.toarray() if hasattr(a.X, \"toarray\") else np.asarray(a.X)\n","        d = pd.DataFrame(X.astype(np.float32), columns=a.var_names.astype(str))\n","        obs = a.obs.reset_index(drop=True); obs.columns = [c + \"_obs\" if c in d.columns else c for c in obs.columns]\n","        d = pd.concat([d, obs], axis=1)\n","        return d.iloc[:nrows] if nrows else d\n","    if fl.endswith(\".parquet\"):\n","        d = pd.read_parquet(f); return d.iloc[:nrows] if nrows else d\n","    return pd.read_csv(f, sep=\"\\t\" if \".tsv\" in fl else \",\", nrows=nrows)\n","\n","def load_table(path, nrows=None):\n","    files = list_files(path); parts = []\n","    for f in files:\n","        d = read_one(f, nrows); d[\"__file__\"] = os.path.basename(f); parts.append(d)\n","        if nrows and len(parts) >= 3: break\n","    df = pd.concat(parts, ignore_index=True) if len(parts) > 1 else parts[0]\n","    for c in df.select_dtypes(\"float64\").columns: df[c] = df[c].astype(np.float32)\n","    return df\n","\n","def resolve_cfg(cfg):\n","    c = dict(PRESETS.get(cfg.get(\"preset\"), {})); c.update({k: v for k, v in cfg.items() if v is not None}); return c\n","\n","def detect(df, cfg):\n","    cfg = resolve_cfg(cfg)\n","    label_col = cfg.get(\"label_col\") or find_col(df, LABEL_CAND)\n","    if label_col is None: raise ValueError(f\"Could not find the cell-type column; set label_col. Columns: {list(df.columns)[:60]}\")\n","    group_col = cfg.get(\"group_col\") or find_col(df, GROUP_CAND, exclude=(label_col,))\n","    if group_col is None and \"__file__\" in df and df[\"__file__\"].nunique() > 1: group_col = \"__file__\"\n","    if group_col is None: raise ValueError(\"No patient/sample/region column found; set group_col (MAPS needs groups to split by).\")\n","    area = cfg.get(\"area_col\", None)\n","    if area is None: area = find_col(df, AREA_CAND, exclude=(label_col, group_col))\n","    if area is False: area = None\n","    if cfg.get(\"marker_cols\"):\n","        missing = [m for m in cfg[\"marker_cols\"] if m not in df.columns]\n","        if missing: raise ValueError(f\"marker_cols not in table: {missing[:5]} ...\")\n","        markers = list(cfg[\"marker_cols\"])\n","    else:\n","        skip = {label_col, group_col, area, \"__file__\"}\n","        markers = [c for c in df.select_dtypes(\"number\").columns if c not in skip and not NONMARKER_RE.search(str(c))]\n","    markers = sorted(markers)                              # authors sort marker names, then append cell size last\n","    return label_col, group_col, area, markers\n","\n","def authors_group_folds(group_counts, n_folds):\n","    \"\"\"Authors' rule (CRC_CODEX.py): sort groups by size, pair smallest+largest, deal pairs to folds in turn.\n","    (With an odd number of groups the middle one stays unassigned = always in train, as in their code.)\n","    Their script used row positions instead of group names here, which crashes on text IDs; names are used here.\"\"\"\n","    names = group_counts.sort_values(kind=\"stable\").index.tolist()\n","    fold_of = {g: -1 for g in names}; i, j, fid = 0, len(names) - 1, 0\n","    while i < j:\n","        fold_of[names[i]] = fid % n_folds; fold_of[names[j]] = fid % n_folds\n","        fid += 1; i += 1; j -= 1\n","    return fold_of\n","\n","def prepare(cfg, df):\n","    \"\"\"-> features DataFrame (markers sorted + cell size), integer labels, group per cell, class names\"\"\"\n","    cfg = resolve_cfg(cfg)\n","    label_col, group_col, area, markers = detect(df, cfg)\n","    y = df[label_col].astype(str).str.strip()\n","    drop = {s.lower() for s in cfg.get(\"drop_labels\", DROP_LABELS)}\n","    keep = ~y.str.lower().isin(drop)\n","    if cfg.get(\"class_mapping\"):\n","        mp = cfg[\"class_mapping\"]\n","        if cfg.get(\"drop_unmapped\"): keep &= y.isin(mp.keys())\n","        y = y.map(lambda v: mp.get(v, v))\n","    cnt = y[keep].value_counts()\n","    small = cnt[cnt < MIN_CELLS_PER_CLASS].index.tolist()\n","    if small: print(f\"  dropping {len(small)} class(es) with < {MIN_CELLS_PER_CLASS} cells: {small}\")\n","    keep &= ~y.isin(small)\n","    feats = markers + ([area] if area else [])\n","    X = df.loc[keep, feats].astype(np.float32).fillna(0)\n","    const = [c for c in X.columns if X[c].nunique() <= 1]\n","    if const: print(f\"  dropping constant columns: {const}\"); X = X.drop(columns=const)\n","    y = y[keep].reset_index(drop=True); g = df.loc[keep, group_col].astype(str).reset_index(drop=True); X = X.reset_index(drop=True)\n","    class_names = sorted(y.unique().tolist()); cid = {c: i for i, c in enumerate(class_names)}\n","    labels = y.map(cid).values\n","    return X, labels, g, class_names, dict(label_col=label_col, group_col=group_col, area_col=area, n_markers=len(markers) - len(const) + (0 if not area or area not in const else 0))\n","\n","def class_counts_by_fold(labels, g, fold_of, k):\n","    f = g.map(fold_of).values\n","    return {i: np.bincount(labels[f == i], minlength=k) for i in range(-1, max(fold_of.values()) + 1)}\n","\n","def _header(f):\n","    fl = f.lower()\n","    if fl.endswith(\".h5ad\"): return (\"__h5ad__\", f)            # each h5ad is its own group\n","    if fl.endswith(\".parquet\"):\n","        import pyarrow.parquet as pq; return tuple(pq.read_schema(f).names)\n","    return tuple(pd.read_csv(f, sep=\"\\t\" if \".tsv\" in fl else \",\", nrows=0).columns)\n","\n","def discover(root):\n","    files = [f for f in glob.glob(os.path.join(root, \"**\", \"*\"), recursive=True) if f.lower().endswith(EXTS)]\n","    if not files: raise FileNotFoundError(f\"No csv/tsv/parquet/h5ad files found under {root}. Did you attach the dataset?\")\n","    groups = {}\n","    for f in files:\n","        try: groups.setdefault(_header(f), []).append(f)\n","        except Exception as e: print(\"  cannot read header of\", f, \"->\", e)\n","    best, best_key = None, None\n","    print(f\"Found {len(files)} table file(s) in {len(groups)} column-signature group(s):\")\n","    for hdr, fs in groups.items():\n","        if hdr and hdr[0] == \"__h5ad__\":\n","            try:\n","                a = anndata.read_h5ad(fs[0], backed=\"r\"); cols = list(a.obs.columns); a.file.close()\n","            except Exception: cols = []\n","        else: cols = list(hdr)\n","        has_label = find_col(pd.DataFrame(columns=cols), LABEL_CAND) is not None\n","        size = sum(os.path.getsize(f) for f in fs)\n","        print(f\"  {len(fs):4d} file(s) | {size/1e6:9.1f} MB | cell-type column: {'yes' if has_label else 'no '} | e.g. {os.path.basename(fs[0])}\")\n","        key = (has_label, size)\n","        if best_key is None or key > best_key: best, best_key = fs, key\n","    if not best_key[0]: print(\"  WARNING: no group has an obvious cell-type column; picking the largest. Set OVERRIDES if wrong.\")\n","    return sorted(best)\n","\n","def auto_preset(df):\n","    need_sorin = set(PRESETS[\"Sorin\"][\"marker_cols\"]) | {\"native_label\", \"patient_id\", \"area_px2\"}\n","    if need_sorin <= set(df.columns):\n","        return \"Sorin\"\n","    need_crc = set(PRESETS[\"authors_CRC_CODEX\"][\"marker_cols\"]) | {\"ClusterName\", \"spots\"}\n","    return \"authors_CRC_CODEX\" if need_crc <= set(df.columns) else None\n","\n","def metrics_one_fold(gt, pred, k):\n","    p, r, f, s = precision_recall_fscore_support(gt, pred, labels=list(range(k)), zero_division=0)\n","    present = s > 0\n","    micro_f1 = (np.asarray(gt) == np.asarray(pred)).mean()   # authors' \"Average\" bar is a micro average (= accuracy)\n","    return p, r, f, s, present, micro_f1\n","\n","def load_harmonized_table(path, columns, nrows=None):\n","    \"\"\"Read only metadata and selected u_coh features from a harmonized Parquet table.\"\"\"\n","    import pyarrow.parquet as pq\n","    if nrows is None:\n","        df = pd.read_parquet(path, columns=columns)\n","    else:\n","        batch = next(pq.ParquetFile(path).iter_batches(batch_size=nrows, columns=columns), None)\n","        if batch is None:\n","            raise ValueError(f\"Harmonized table is empty: {path}\")\n","        df = batch.to_pandas()\n","    df[\"__file__\"] = os.path.basename(path)\n","    for c in df.select_dtypes(\"float64\").columns:\n","        df[c] = df[c].astype(np.float32)\n","    return df\n"]},{"cell_type":"markdown","id":"28210579","metadata":{"papermill":{"duration":0.003181,"end_time":"2026-11-21T22:25:47.103562+00:00","exception":false,"start_time":"2026-11-21T22:25:47.100381+00:00","status":"completed"},"tags":[]},"source":["## 7. Check (fast): what was detected for each dataset?"]},{"cell_type":"code","execution_count":14,"id":"8549ff5b","metadata":{"execution":{"iopub.execute_input":"2026-11-21T22:25:47.11177Z","iopub.status.busy":"2026-11-21T22:25:47.111173Z","iopub.status.idle":"2026-11-21T22:25:48.155315Z","shell.execute_reply":"2026-11-21T22:25:48.154346Z"},"papermill":{"duration":1.050254,"end_time":"2026-11-21T22:25:48.15704+00:00","exception":false,"start_time":"2026-11-21T22:25:47.106786+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Dataset: ferguson | source: /kaggle/input/datasets/ashrafulislamtanzil/ferguson-par/ferguson_full.parquet\n","Using 34 u_coh marker features; excluding raw/u_img channels and area\n","  preview rows: 5,000 | target: native_label | groups: patient_id (3 in preview)\n","  labels in preview: 9 | harmonized features: 34\n"]}],"source":["import pyarrow.parquet as pq\n","\n","expected_file = \"ferguson_full.parquet\"\n","source_files = []\n","for root, _, names in os.walk(INPUT_ROOT):\n","    source_files.extend(os.path.join(root, f) for f in names if f.lower() == expected_file.lower())\n","if len(source_files) != 1:\n","    raise FileNotFoundError(\n","        f\"Expected exactly one attached {expected_file}; found {len(source_files)}. \"\n","        \"Attach this cohort's harmonized data and avoid duplicate copies.\"\n","    )\n","source_path = source_files[0]\n","schema_columns = pq.read_schema(source_path).names\n","feature_cols = [c for c in schema_columns if c.startswith(HARMONIZED_PREFIX)]\n","if not feature_cols:\n","    raise ValueError(f\"{expected_file} has no columns with the expected {HARMONIZED_PREFIX!r} prefix.\")\n","required_meta = [\"native_label\", \"patient_id\"]\n","missing_meta = [c for c in required_meta if c not in schema_columns]\n","if missing_meta:\n","    raise ValueError(f\"{expected_file} is missing required columns: {missing_meta}\")\n","input_columns = required_meta + feature_cols\n","name = \"ferguson\"\n","cfg0 = dict(path=[source_path], harmonized_input=True, input_columns=input_columns,\n","            marker_cols=feature_cols, **OVERRIDES)\n","DATASETS = {name: cfg0}\n","print(\"Dataset:\", name, \"| source:\", source_path)\n","print(\"Using\", len(feature_cols), \"u_coh marker features; excluding raw/u_img channels and area\")\n","\n","def selected():\n","    return list(DATASETS)\n","\n","for name in selected():\n","    cfg = DATASETS[name]\n","    df = load_harmonized_table(source_path, input_columns, nrows=5000)\n","    lab, grp, area, mk = detect(df, cfg)\n","    print(f\"  preview rows: {len(df):,} | target: {lab} | groups: {grp} ({df[grp].nunique()} in preview)\")\n","    print(f\"  labels in preview: {df[lab].astype(str).nunique()} | harmonized features: {len(mk)}\")\n","    if lab != \"native_label\" or grp != \"patient_id\" or area is not None:\n","        raise ValueError(\"Unexpected harmonized input mapping; expected native_label, patient_id and no cell-size column.\")\n"]},{"cell_type":"markdown","id":"1645047d","metadata":{"papermill":{"duration":0.003406,"end_time":"2026-11-21T22:25:48.164109+00:00","exception":false,"start_time":"2026-11-21T22:25:48.160703+00:00","status":"completed"},"tags":[]},"source":["## 8. Main run\n","One dataset at a time. For each fold: write temporary train/valid/test CSVs → authors' `Trainer.fit` → authors' `Predictor.predict` on the **test fold** → metrics → delete the temporary CSVs. Finished folds are skipped if you re-run."]},{"cell_type":"code","execution_count":15,"id":"9607ec1a","metadata":{"execution":{"iopub.execute_input":"2026-11-21T22:25:48.172816Z","iopub.status.busy":"2026-11-21T22:25:48.172338Z","iopub.status.idle":"2026-11-21T22:25:49.773256Z","shell.execute_reply":"2026-11-21T22:25:49.772449Z"},"papermill":{"duration":1.608809,"end_time":"2026-11-21T22:25:49.776447+00:00","exception":false,"start_time":"2026-11-21T22:25:48.167638+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["================================================================================ \\n ferguson\n","  cells: 40,000 | classes: 9 | features: 34 | groups (patient_id): 17 | folds: 5\n","  folds this session: [0, 1, 2, 3, 4]\n","  hp: {'batch_size': 128, 'learning_rate': 0.001, 'dropout': 0.25, 'max_epochs': 500, 'min_epochs': 100, 'patience': 50, 'seed': 7325111, 'num_workers': 4}\n","  fold 0: found saved results, skipping training\n","           macro F1 = 0.720 | micro F1 (= accuracy) = 0.701\n","  fold 1: found saved results, skipping training\n","           macro F1 = 0.743 | micro F1 (= accuracy) = 0.715\n","  fold 2: found saved results, skipping training\n","           macro F1 = 0.709 | micro F1 (= accuracy) = 0.700\n","  fold 3: found saved results, skipping training\n","           macro F1 = 0.730 | micro F1 (= accuracy) = 0.752\n","  fold 4: found saved results, skipping training\n","           macro F1 = 0.703 | micro F1 (= accuracy) = 0.717\n","          precision        recall            f1       \n","               mean    std   mean    std   mean    std\n","cell_type                                             \n","BC            0.697  0.078  0.704  0.226  0.687  0.129\n","DC            0.736  0.206  0.825  0.081  0.762  0.140\n","EC            0.757  0.159  0.717  0.167  0.708  0.047\n","EP            0.607  0.093  0.644  0.126  0.617  0.075\n","GC            0.837  0.137  0.828  0.128  0.817  0.047\n","MC            0.758  0.096  0.817  0.105  0.778  0.045\n","SC            0.682  0.151  0.473  0.085  0.545  0.043\n","TC_CD4        0.790  0.074  0.700  0.035  0.741  0.039\n","TC_CD8        0.816  0.111  0.871  0.061  0.837  0.047\n","  AVERAGE F1 over evaluated folds: 0.721 +/- 0.016 | micro: 0.717 +/- 0.021\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1400x465 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["def run_dataset(name, cfg):\n","    t0 = time.time(); print(\"=\" * 80, \"\\\\n\", name)\n","    if cfg.get(\"harmonized_input\"):\n","        df = load_harmonized_table(cfg[\"path\"][0], cfg[\"input_columns\"])\n","    else:\n","        df = load_table(cfg[\"path\"])\n","    X, labels, g, class_names, info = prepare(cfg, df)\n","    del df; gc.collect()\n","    k = len(class_names); nfeat = X.shape[1]\n","    hp = dict(DEFAULT_HP); hp.update(cfg.get(\"hp\", {}))\n","    n_groups = g.nunique()\n","    n_folds = min(N_FOLDS, n_groups // 2)\n","    if n_folds < 2: raise ValueError(f\"Only {n_groups} groups in '{info['group_col']}'; need >= 4. Use a finer group_col (e.g. region/FOV), but that can leak patients.\")\n","    if n_folds < N_FOLDS: print(f\"  WARNING: only {n_groups} groups -> using {n_folds} folds\")\n","    folds_to_run = list(range(n_folds)) if FOLD_SELECTION is None else list(FOLD_SELECTION)\n","    invalid_folds = [fold for fold in folds_to_run if fold < 0 or fold >= n_folds]\n","    if invalid_folds: raise ValueError(f\"FOLD_SELECTION contains invalid folds {invalid_folds}; valid folds are 0..{n_folds - 1}.\")\n","    fold_of = authors_group_folds(g.value_counts(), n_folds)\n","    cc = class_counts_by_fold(labels, g, fold_of, k)\n","    print(f\"  cells: {len(labels):,} | classes: {k} | features: {nfeat} | groups ({info['group_col']}): {n_groups} | folds: {n_folds}\")\n","    print(f\"  folds this session: {folds_to_run}\")\n","    print(f\"  hp: {hp}\")\n","\n","    out = os.path.join(OUT_ROOT, name); os.makedirs(out, exist_ok=True)\n","    run_info_path = os.path.join(out, \"run_info.json\")\n","    class_names_path = os.path.join(out, \"class_names.csv\")\n","    if os.path.exists(run_info_path):\n","        prior = json.load(open(run_info_path, encoding=\"utf-8\"))\n","        if prior.get(\"features\") != X.columns.tolist():\n","            raise ValueError(\"Resume input features differ from Session 1; attach the identical harmonized file.\")\n","        if prior.get(\"hp\") != hp or prior.get(\"folds\") != n_folds or prior.get(\"group_col\") != info[\"group_col\"]:\n","            raise ValueError(\"Resume settings differ from Session 1; restore the matching input/settings.\")\n","        if os.path.exists(class_names_path):\n","            old_classes = pd.read_csv(class_names_path)[\"class_name\"].astype(str).tolist()\n","            if old_classes != class_names:\n","                raise ValueError(\"Resume label classes differ from Session 1; attach the identical harmonized file.\")\n","    pd.DataFrame({\"class_id\": range(k), \"class_name\": class_names, \"cells\": np.bincount(labels, minlength=k)}).to_csv(class_names_path, index=False)\n","    json.dump(dict(maps_commit=\"72d4bc81cf4e28f19a766693c885670e47ab3e6e\", features=X.columns.tolist(), hp=hp, folds=n_folds, group_col=info[\"group_col\"],\n","                   selected_folds=folds_to_run, patches=\"np.Inf->np.inf; torch.load weights_only=False; efficient prediction accumulation; epoch-level resume\"), open(f\"{out}/run_info.json\", \"w\"), indent=1)\n","\n","    fold_arr = g.map(fold_of).values\n","    rows, cm_total, summaries = [], np.zeros((k, k)), []\n","    for fold in folds_to_run:\n","        res_path = f\"{out}/fold_{fold}/results_test.csv\"\n","        if os.path.exists(res_path):\n","            r = pd.read_csv(res_path); gt, pred = r[\"gt_label\"].values, r[\"pred_label\"].values\n","            print(f\"  fold {fold}: found saved results, skipping training\")\n","        else:\n","            test_idx = np.where(fold_arr == fold)[0]; trainval_idx = np.where(fold_arr != fold)[0]\n","            # authors' cHL_CODEX.py: 80/20 stratified split of the training part -> train / valid (first split only)\n","            skf = StratifiedKFold(n_splits=5, random_state=SPLIT_SEED, shuffle=True)\n","            tr_i, va_i = next(iter(skf.split(np.zeros(len(trainval_idx)), labels[trainval_idx])))\n","            tr_idx, va_idx = trainval_idx[tr_i], trainval_idx[va_i]\n","            miss = [class_names[c] for c in range(k) if (np.bincount(labels[va_idx], minlength=k)[c] == 0) or (np.bincount(labels[tr_idx], minlength=k)[c] == 0)]\n","            if miss: raise ValueError(f\"fold {fold}: class(es) {miss} missing from train or valid; raise MIN_CELLS_PER_CLASS or merge classes (class_mapping).\")\n","            tmp = f\"{out}/fold_{fold}/tmp\"; os.makedirs(tmp, exist_ok=True)\n","            for nm, idx in [(\"train\", tr_idx), (\"valid\", va_idx), (\"test\", test_idx)]:\n","                d = X.iloc[idx].copy(); d[\"cell_label\"] = labels[idx]; d.to_csv(f\"{tmp}/{nm}.csv\", index=False, float_format=\"%.8g\")\n","            ck_dir = f\"{out}/fold_{fold}\"\n","            tf = time.time()\n","            model = Trainer(results_dir=ck_dir, num_features=nfeat, num_classes=k, batch_size=hp[\"batch_size\"],\n","                            learning_rate=hp[\"learning_rate\"], dropout=hp[\"dropout\"], max_epochs=hp[\"max_epochs\"],\n","                            min_epochs=hp[\"min_epochs\"], patience=hp[\"patience\"], seed=hp[\"seed\"],\n","                            num_workers=hp[\"num_workers\"], verbose=0)\n","            try:\n","                with open(f\"{ck_dir}/train_stdout.log\", \"w\") as fh, contextlib.redirect_stdout(fh):\n","                    model.fit(f\"{tmp}/train.csv\", f\"{tmp}/valid.csv\")\n","            except SessionBudgetReached:\n","                print(f\"  Paused fold {fold} at the 9-hour safety limit. Save maps_results and resume this run in a new Kaggle session.\")\n","                return dict(dataset=name, cells=len(labels), cell_types=k, groups=n_groups,\n","                            folds=n_folds, features=nfeat, status=\"paused\", paused_fold=fold,\n","                            minutes=round((time.time() - t0) / 60, 1), error=\"\")\n","            pr = Predictor(model_checkpoint_path=f\"{ck_dir}/best_checkpoint.pt\", num_features=nfeat, num_classes=k,\n","                           batch_size=hp[\"batch_size\"], seed=hp[\"seed\"], num_workers=hp[\"num_workers\"], normalization=True, verbose=0)\n","            with contextlib.redirect_stdout(open(os.devnull, \"w\")):\n","                pred, probs = pr.predict(f\"{tmp}/test.csv\")\n","            gt = labels[test_idx]\n","            r = pd.DataFrame({\"pred_label\": pred, \"gt_label\": gt, \"group\": g.values[test_idx]})\n","            if SAVE_PROBS: r = pd.concat([r, pd.DataFrame(probs, columns=[c + \"_prob\" for c in class_names])], axis=1)\n","            r.to_csv(res_path, index=False)\n","            shutil.rmtree(tmp, ignore_errors=True)\n","            lg = pd.read_csv(f\"{ck_dir}/training_logs.csv\")\n","            print(f\"  fold {fold}: {len(lg)} epochs, best valid loss {lg['valid_loss'].min():.4f}, {(time.time()-tf)/60:.1f} min\")\n","        p, rc, f1, s, present, micro = metrics_one_fold(gt, pred, k)\n","        for c in range(k):\n","            rows.append(dict(fold=fold, cell_type=class_names[c], precision=p[c] if present[c] else np.nan,\n","                             recall=rc[c] if present[c] else np.nan, f1=f1[c] if present[c] else np.nan, support=int(s[c])))\n","        summaries.append(dict(fold=fold, macro_f1=np.nanmean(f1[present]), micro_f1=micro))\n","        cm_total += confusion_matrix(gt, pred, labels=list(range(k)))\n","        print(f\"           macro F1 = {summaries[-1]['macro_f1']:.3f} | micro F1 (= accuracy) = {micro:.3f}\")\n","\n","    if not rows:\n","        raise ValueError(\"No folds selected or available to evaluate.\")\n","    res = pd.DataFrame(rows); sm = pd.DataFrame(summaries)\n","    res.to_csv(f\"{out}/f1_per_fold_per_class.csv\", index=False); sm.to_csv(f\"{out}/f1_per_fold_overall.csv\", index=False)\n","    table = res.groupby(\"cell_type\")[[\"precision\", \"recall\", \"f1\"]].agg([\"mean\", \"std\"]).round(3)\n","    table.to_csv(f\"{out}/f1_summary_per_class.csv\"); print(table)\n","    print(f\"  AVERAGE F1 over evaluated folds: {sm.macro_f1.mean():.3f} +/- {sm.macro_f1.std():.3f} | micro: {sm.micro_f1.mean():.3f} +/- {sm.micro_f1.std():.3f}\")\n","\n","    f1m = res.groupby(\"cell_type\")[\"f1\"].agg([\"mean\", \"std\"]).sort_values(\"mean\")\n","    fig, ax = plt.subplots(1, 2, figsize=(14, max(4, 0.35 * k + 1.5)))\n","    ax[0].barh(f1m.index, f1m[\"mean\"], xerr=f1m[\"std\"].fillna(0), color=\"steelblue\"); ax[0].set_xlim(0, 1)\n","    ax[0].set_xlabel(\"F1 (mean +/- SD across evaluated folds)\"); ax[0].set_title(name)\n","    cmn = cm_total / np.clip(cm_total.sum(1, keepdims=True), 1, None)\n","    sns.heatmap(cmn, annot=k <= 15, fmt=\".2f\", cmap=\"Blues\", xticklabels=class_names, yticklabels=class_names, ax=ax[1])\n","    ax[1].set_xlabel(\"Predicted\"); ax[1].set_ylabel(\"Ground truth\")\n","    plt.tight_layout(); plt.savefig(f\"{out}/f1_and_confusion.png\", dpi=150); plt.show(); plt.close()\n","    return dict(dataset=name, cells=len(labels), cell_types=k, groups=n_groups, folds=len(folds_to_run), features=nfeat,\n","                macro_f1=round(sm.macro_f1.mean(), 3), macro_sd=round(sm.macro_f1.std(), 3),\n","                micro_f1=round(sm.micro_f1.mean(), 3), minutes=round((time.time() - t0) / 60, 1), error=\"\")\n","\n","ALL = []\n","for name in selected():\n","    try:\n","        run_result = run_dataset(name, DATASETS[name])\n","        ALL.append(run_result)\n","        if run_result.get(\"status\") == \"paused\":\n","            break\n","    except Exception as e:\n","        import traceback; traceback.print_exc(); ALL.append(d