x=False)\n","        state = {\n","            \"next_epoch\": epoch + 1,\n","            \"model_state\": self.model.state_dict(),\n","            \"optimizer_state\": self.optimizer.state_dict(),\n","            \"counter\": self.counter,\n","            \"lowest_loss\": self.lowest_loss,\n","            \"result_dict\": result_dict,\n","            \"signature\": signature,\n","            \"python_rng\": random.getstate(),\n","            \"numpy_rng\": np.random.get_state(),\n","            \"torch_rng\": torch.get_rng_state(),\n","            \"cuda_rng\": torch.cuda.get_rng_state_all() if torch.cuda.is_available() else None,\n","        }\n","        temp_path = resume_path + \".tmp\"\n","        torch.save(state, temp_path)\n","        os.replace(temp_path, resume_path)\n","        print(\"Epoch {} complete in {:.1f} min; resumable state saved.\".format(\n","            epoch, (time.time() - start_time) / 60))\n","        if (self.counter > self.patience) and (epoch >= self.min_epochs):\n","            break\n","\n","Trainer.fit = _fit_resumable\n","print(\"MAPS loaded; optimized prediction accumulation and enabled epoch-level resume checkpoints\")"]},{"cell_type":"markdown","id":"5209d4e0","metadata":{"papermill":{"duration":0.003431,"end_time":"2026-11-21T22:25:42.207958+00:00","exception":false,"start_time":"2026-11-21T22:25:42.204527+00:00","status":"completed"},"tags":[]},"source":["## 4. Files you attached (Kaggle)"]},{"cell_type":"code","execution_count":10,"id":"a0a68253","metadata":{"execution":{"iopub.execute_input":"2026-11-21T22:25:42.215592Z","iopub.status.busy":"2026-11-21T22:25:42.2149Z","iopub.status.idle":"2026-11-21T22:25:42.644864Z","shell.execute_reply":"2026-11-21T22:25:42.644119Z"},"papermill":{"duration":0.435702,"end_time":"2026-11-21T22:25:42.646731+00:00","exception":false,"start_time":"2026-11-21T22:25:42.211029+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["     16.0 MB  /kaggle