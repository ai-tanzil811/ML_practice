]},"source":["## 6. Helper functions"]},{"cell_type":"code","execution_count":13,"id":"8320b2ac","metadata":{"execution":{"iopub.execute_input":"2026-11-17T14:00:25.641571Z","iopub.status.busy":"2026-11-17T14:00:25.641042Z","iopub.status.idle":"2026-11-17T14:00:25.67611Z","shell.execute_reply":"2026-11-17T14:00:25.675384Z"},"papermill":{"duration":0.040328,"end_time":"2026-11-17T14:00:25.677584+00:00","exception":false,"start_time":"2026-11-17T14:00:25.637256+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["norm = lambda s: re.sub(r\"[^a-z0-9]\", \"\", str(s).lower())\n","LABEL_CAND = [\"clustername\",\"celltype\",\"celltypename\",\"cellphenotype\",\"phenotype\",\"cellannotation\",\"annotation\",\"cellclass\",\n","              \"majorcelltype\",\"celltypemajor\",\"metacluster\",\"cellmetacluster\",\"cluster\",\"clusters\",\"label\",\"labels\",\"cellsubtype\"]\n","GROUP_CAND = [\"patientid\",\"patient\",\"patients\",\"donor\",\"donorid\",\"subject\",\"subjectid\",\"caseid\",\"case\",\"sampleid\",\"sample\",\n","              \"samplename\",\"slideid\",\"slide\",\"imageid\",\"image\",\"imagenumber\",\"roi\",\"roiid\",\"region\",\"regionid\",\"spots\",\"spot\",\n","              \"fov\",\"tissueid\",\"tissue\",\"core\"]\n","AREA_CAND  = [\"cellsize\",\"area\",\"cellarea\",\"size\",\"nucleusarea\",\"nucleussize\",\"areapx\"]\n","NONMARKER_RE = re.compile(r\"(^|[^a-z])(x|y|z)([^a-z]|$)|centroid|coord|^index$|cell.?id|^id$|object.?id|label|fov|region|\"\n","                          r\"sample|patient|image|slide|core|roi|eccentric|solidity|perimeter|orientation|axis|extent|\"\n","                          r\"neighbo|cluster|annot|type|phenotype|tissue|donor|case|batch|unnamed|spot|tile|^__\", re.I)\n","EXTS = (\".csv\", \".tsv\", \".csv.gz\", \".tsv.gz\", \".parquet\", \".h5ad\")\n","\n","# ---- authors' own mapping for the Schurch CRC CODEX table (copied from scripts/MAPS/data_preprocessing/CRC_CODEX.py) ----\n","CRC_CLASS_MAPPING = {'B cells': 'B cells', 'CD11b+CD68+ macrophages': 'Macrophages', 'CD11c+ DCs': 'CD11c+ DCs',\n","    'CD163+ macrophages': 'Macrophages', 'CD4+ T cells': 'CD4+ T cells', 'CD4+ T cells CD45RO+': 'CD4+ T cells',\n","    'CD4+ T cells GATA3+': 'CD4+ T cells', 'CD68+ macrophages': 'Macrophages', 'CD68+ macrophages GzmB+': 'Macrophages',\n","    'CD68+CD163+ macrophages': 'Macrophages', 'CD8+ T cells': 'CD8+ T cells', 'NK cells': 'NK cells', 'Tregs': 'Tregs',\n","    'granulocytes': 'Granulocytes', 'immune cells': 'Immune cells', 'plasma cells': 'Plasma cells',\n","    'smooth muscle': 'Smooth muscle', 'stroma': 'Stroma', 'tumor cells': 'Tumor cells', 'vasculature': 'Vasculature'}\n","CRC_MARKERS = [\"aSMA - smooth muscle:Cyc_11_ch_2\",\"beta-catenin - Wnt signaling:Cyc_4_ch_4\",\"CD11b - macrophages:Cyc_10_ch_3\",\n"," \"CD11c - DCs:Cyc_12_ch_3\",\"CD138 - plasma cells:Cyc_21_ch_3\",\"CD15 - granulocytes:Cyc_14_ch_2\",\"CD163 - macrophages:Cyc_17_ch_3\",\n"," \"CD20 - B cells:Cyc_8_ch_3\",\"CD21 - DCs:Cyc_6_ch_4\",\"CD3 - T cells:Cyc_16_ch_4\",\"CD31 - vasculature:Cyc_19_ch_3\",\n"," \"CD34 - vasculature:Cyc_20_ch_3\",\"CD38 - multifunctional:Cyc_20_ch_4\",\"CD4 - T helper cells:Cyc_6_ch_3\",\"CD44 - stroma:Cyc_2_ch_2\",\n"," \"CD45 - hematopoietic cells:Cyc_4_ch_2\",\"CD45RA - naive T cells:Cyc_6_ch_2\",\"CD45RO - memory cells:Cyc_18_ch_3\",\n"," \"CD56 - NK cells:Cyc_10_ch_4\",\"CD68 - macrophages:Cyc_18_ch_4\",\"CD7 - T cells:Cyc_16_ch_3\",\"CD8 - cytotoxic T cells:Cyc_3_ch_2\",\n"," \"Chromogranin A - neuroendocrine:Cyc_17_ch_2\",\"Cytokeratin - epithelia:Cyc_10_ch_2\",\"FOXP3 - regulatory T cells:Cyc_2_ch_3\",\n"," \"GATA3 - Th2 helper T cells:Cyc_3_ch_4\",\"GFAP - nerves:Cyc_16_ch_2\",\"Granzyme B - cytotoxicity:Cyc_13_ch_2\",\n"," \"HLA-DR - MHC-II:Cyc_5_ch_2\",\"MUC-1 - epithelia:Cyc_7_ch_2\",\"Na-K-ATPase - membranes:Cyc_9_ch_2\",\n"," \"p53 - tumor suppressor:Cyc_3_ch_3\",\"Podoplanin - lymphatics:Cyc_19_ch_4\",\"Synaptophysin - neuroendocrine:Cyc_15_ch_3\"]\n","PRESETS = {\"authors_CRC_CODEX\": dict(label_col=\"ClusterName\", group_col=\"spots\", area_col=False, marker_cols=CRC_MARKERS,\n","                                     class_mapping=CRC_CLASS_MAPPING, drop_unmapped=True)}\n","\n","def find_col(df, cands, exclude=()):\n","    m = {norm(c): c for c in df.columns}\n","    for c in cands:\n","        if c in m and m[c] not in exclude: return m[c]\n","    return None\n","\n","def list_files(path):\n","    paths = path if isinstance(path, (list, tuple)) else [path]\n","    files = []\n","    for p in paths:\n","        if os.path.isdir(p): files += [f for f in glob.glob(os.path.join(p, \"**\", \"*\"), recursive=True) if f.lower().endswith(EXTS)]\n","        else: files += glob.glob(p, recursive=True)\n","    files = sorted(set(files))\n","    if not files: raise FileNotFoundError(f\"No data files found for: {path}\")\n","    return files\n","\n","def read_one(f, nrows=None):\n","    fl = f.lower()\n","    if fl.endswith(\".h5ad\"):\n","        a = anndata.read_h5ad(f)\n","        X = a.X.toarray() if hasattr(a.X, \"toarray\") else np.asarray(a.X)\n","        d = pd.DataFrame(X.astype(np.float32), columns=a.var_names.astype(str))\n","        obs = a.obs.reset_index(drop=True); obs.columns = [c + \"_obs\" if c in d.columns else c for c in obs.columns]\n","        d = pd.concat([d, obs], axis=1)\n","        return d.iloc[:nrows] if nrows else d\n","    if fl.endswith(\".parquet\"):\n","        d = pd.read_parquet(f); return d.iloc[:nrows] if nrows else d\n","    return pd.read_csv(f, sep=\"\\t\" if \".tsv\" in fl else \",\", nrows=nrows)\n","\n","def load_table(path, nrows=None):\n","    files = list_files(path); parts = []\n","    for f in files:\n","        d = read_one(f, nrows); d[\"__file__\"] = os.path.basename(f); parts.append(d)\n","        if nrows and len(parts) >= 3: break\n","    df = pd.concat(parts, ignore_index=True) if len(parts) > 1 else parts[0]\n","    for c in df.select_dtypes(\"float64\").columns: df[c] = df[c].astype(np.float32)\n","    return df\n","\n","def resolve_cfg(cfg):\n","    c = dict(PRESETS.get(cfg.get(\"preset\"), {})); c.update({k: v for k, v in cfg.items() if v is not None}); return c\n","\n","def detect(df, cfg):\n","    cfg = resolve_cfg(cfg)\n","    label_col = cfg.get(\"label_col\") or find_col(df, LABEL_CAND)\n","    if label_col is None: raise ValueError(f\"Could not find the cell-type column; set label_col. Columns: {list(df.columns)[:60]}\")\n","    group_col = cfg.get(\"group_col\") or find_col(df, GROUP_CAND, exclude=(label_col,))\n","    if group_col is None and \"__file__\" in df and df[\"__file__\"].nunique() > 1: group_col = \"__file__\"\n","    if group_col is None: raise ValueError(\"No patient/sample/region column found; set group_col (MAPS needs groups to split by).\")\n","    area = cfg.get(\"area_col\", None)\n","    if area is None: area = find_col(df, AREA_CAND, exclude=(label_col, group_col))\n","    if area is False: area = None\n","    if cfg.get(\"marker_cols\"):\n","        missing = [m for m in cfg[\"marker_cols\"] if m not in df.columns]\n","        if missing: raise ValueError(f\"marker_cols not in table: {missing[:5]} ...\")\n","        markers = list(cfg[\"marker_cols\"])\n","    else:\n","        skip = {label_col, group_col, area, \"__file__\"}\n","        markers = [c for c in df.select_dtypes(\"number\").columns if c not in skip and not NONMARKER_RE.search(str(c))]\n","    markers = sorted(markers)                              # authors sort marker names, then append cell size last\n","    return label_col, group_col, area, markers\n","\n","def authors_group_folds(group_counts, n_folds):\n","    \"\"\"Authors' rule (CRC_CODEX.py): sort groups by size, pair smallest+largest, deal pairs to folds in turn.\n","    (With an odd number of groups the middle one stays unassigned = always in train, as in their code.)\n","    Their script used row positions instead of group names here, which crashes on text IDs; names are used here.\"\"\"\n","    names = group_counts.sort_values(kind=\"stable\").index.tolist()\n","    fold_of = {g: -1 for g in names}; i, j, fid = 0, len(names) - 1, 0\n","    while i < j:\n","        fold_of[names[i]] = fid % n_folds; fold_of[names[j]] = fid % n_folds\n","        fid += 1; i += 1; j -= 1\n","    return fold_of\n","\n","def prepare(cfg, df):\n","    \"\"\"-> features DataFrame (markers sorted + cell size), integer labels, group per cell, class names\"\"\"\n","    cfg = resolve_cfg(cfg)\n","    label_col, group_col, area, markers = detect(df, cfg)\n","    y = df[label_col].astype(str).str.strip()\n","    drop = {s.lower() for s in cfg.get(\"drop_labels\", DROP_LABELS)}\n","    keep = ~y.str.lower().isin(drop)\n","    if cfg.get(\"class_mapping\"):\n","        mp = cfg[\"class_mapping\"]\n","        if cfg.get(\"drop_unmapped\"): keep &= y.isin(mp.keys())\n","        y = y.map(lambda v: mp.get(v, v))\n","    cnt = y[keep].value_counts()\n","    small = cnt[cnt < MIN_CELLS_PER_CLASS].index.tolist()\n","    if small: print(f\"  dropping {len(small)} class(es) with < {MIN_CELLS_PER_CLASS} cells: {small}\")\n","    keep &= ~y.isin(small)\n","    feats = markers + ([area] if area else [])\n","    X = df.loc[keep, feats].astype(np.float32).fillna(0)\n","    const = [c for c in X.columns if X[c].nunique() <= 1]\n","    if const: print(f\"  dropping constant columns: {const}\"); X = X.drop(columns=const)\n","    y = y[keep].reset_index(drop=True); g = df.loc[keep, group_col].astype(str).reset_index(drop=True); X = X.reset_index(drop=True)\n","    class_names = sorted(y.unique().tolist()); cid = {c: i for i, c in enumerate(class_names)}\n","    labels = y.map(cid).values\n","    return X, labels, g, class_names, dict(label_col=label_col, group_col=group_col, area_col=area, n_markers=len(markers) - len(const) + (0 if not area or area not in const else 0))\n","\n","def class_counts_by_fold(labels, g, fold_of, k):\n","    f = g.map(fold_of).values\n","    return {i: np.bincount(labels[f == i], minlength=k) for i in range(-1, max(fold_of.values()) + 1)}\n","\n","def _header(f):\n","    fl = f.lower()\n","    if fl.endswith(\".h5ad\"): return (\"__h5ad__\", f)            # each h5ad is its own group\n","    if fl.endswith(\".parquet\"):\n","        import pyarrow.parquet as pq; return tuple(pq.read_schema(f).names)\n","    return tuple(pd.read_csv(f, sep=\"\\t\" if \".tsv\" in fl else \",\", nrows=0).columns)\n","\n","def discover(root):\n","    files = [f for f in glob.glob(os.path.join(root, \"**\", \"*\"), recursive=True) if f.lower().endswith(EXTS)]\n","    if not files: raise FileNotFoundError(f\"No csv/tsv/parquet/h5ad files found under {root}. Did you attach the dataset?\")\n","    groups = {}\n","    for f in files:\n","        try: groups.setdefault(_header(f), []).append(f)\n","        except Exception as e: print(\"  cannot read header of\", f, \"->\", e)\n","    best, best_key = None, None\n","    print(f\"Found {len(files)} table file(s) in {len(groups)} column-signature group(s):\")\n","    for hdr, fs in groups.items():\n","        if hdr and hdr[0] == \"__h5ad__\":\n","            try:\n","                a = anndata.read_h5ad(fs[0], backed=\"r\"); cols = list(a.obs.columns); a.file.close()\n","            except Exception: cols = []\n","        else: cols = list(hdr)\n","        has_label = find_col(pd.DataFrame(columns=cols), LABEL_CAND) is not None\n","        size = sum(os.path.getsize(f) for f in fs)\n","        print(f\"  {len(fs):4d} file(s) | {size/1e6:9.1f} MB | cell-type column: {'yes' if has_label else 'no '} | e.g. {os.path.basename(fs[0])}\")\n","        key = (has_label, size)\n","        if best_key is None or key > best_key: best, best_key = fs, key\n","    if not best_key[0]: print(\"  WARNING: no group has an obvious cell-type column; picking the largest. Set OVERRIDES if wrong.\")\n","    return sorted(best)\n","\n","def auto_preset(df):\n","    need = set(PRESETS[\"authors_CRC_CODEX\"][\"marker_cols\"]) | {\"ClusterName\", \"spots\"}\n","    return \"authors_CRC_CODEX\" if need <= set(df.columns) else None\n","\n","def metrics_one_fold(gt, pred, k):\n","    p, r, f, s = precision_recall_fscore_support(gt, pred, labels=list(range(k)), zero_division=0)\n","    present = s > 0\n","    micro_f1 = (np.asarray(gt) == np.asarray(pred)).mean()   # authors' \"Average\" bar is a micro average (= accuracy)\n","    return p, r, f, s, present, micro_f1\n"]},{"cell_type":"markdown","id":"ec01a77d","metadata":{"papermill":{"duration":0.002878,"end_time":"2026-11-17T14:00:25.683444+00:00","exception":false,"start_time":"2026-11-17T14:00:25.680566+00:00","status":"completed"},"tags":[]},"source":["## 7. Check (fast): what was detected for each dataset?"]},{"cell_type":"code","execution_count":14,"id":"8eed15d6","metadata":{"execution":{"iopub.execute_input":"2026-11-17T14:00:25.689957Z","iopub.status.busy":"2026-11-17T14:00:25.689652Z","iopub.status.idle":"2026-11-17T14:00:26.127805Z","shell.execute_reply":"2026-11-17T14:00:26.126902Z"},"papermill":{"duration":0.443384,"end_time":"2026-11-17T14:00:26.12961+00:00","exception":false,"start_time":"2026-11-17T14:00:25.686226+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Found 2 table file(s) in 2 column-signature group(s):\n","     1 file(s) |      63.0 MB | cell-type column: yes | e.g. ferguson_cells_counts.csv\n","     1 file(s) |       0.0 MB | cell-type column: no  | e.g. marker_panel.csv\n","Dataset name: csv_export | files used: 1\n","================================================================================ \n"," csv_export\n","  files: 1 | label_col: cellType | group_col: patientID (1 groups in first rows) | cell size col: area\n","  classes (first rows): 9 | markers (37): ['CADM1', 'CCR7', 'CD13', 'CD14', 'CD16', 'CD20', 'CD3', 'CD31', 'CD4', 'CD45RA', 'CD45RO', 'CD66a', 'CD68', 'CD8a', 'CXCR3', 'DNA1', 'DNA2', 'FX111A', 'FoxP3', 'HH3', 'HLADR', 'ICOS', 'IDO', 'Ki67', 'LAG3', 