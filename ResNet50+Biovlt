after attaching the NIH dataset and extracted single-model\n","ResNet50/BioViL-T result bundles:\n","    python resnet50_biovil_t_distill.py\n","\n","The probability-average teacher is ResNet50 + BioViL-T. The fresh\n","ResNet student starts from ImageNet initialization, not the\n","fine-tuned ResNet baseline checkpoint. Outputs are isolated under\n","distill/resnet50_biovil_t.\n","\"\"\"\n","\n","import argparse\n","import hashlib\n","import json\n","import os\n","os.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")\n","import random\n","import sys\n","import time\n","from pathlib import Path\n","\n","import numpy as np\n","import pandas as pd\n","import torch\n","import torch.nn as nn\n","import torchvision.transforms as T\n","from PIL import Image\n","from scipy.optimize import minimize\n","from scipy.special import expit\n","from sklearn.model_selection import GroupShuffleSplit\n","from sklearn.metrics import average_precision_score, roc_auc_score\n","from torch.utils.data import DataLoader, Dataset\n","\n","\n","LABELS = [\n","    \"Atelectasis\",\n","    \"Cardiomegaly\",\n","    \"Effusion\",\n","    \"Infiltration\",\n","    \"Mass\",\n","    \"Nodule\",\n","    \"Pneumonia\",\n","    \"Pneumothorax\",\n","    \"Consolidation\",\n","    \"Edema\",\n","    \"Emphysema\",\n","    \"Fibrosis\",\n","    \"Pleural_Thickening\",\n","    \"Hernia\",\n","]\n","LABEL_ARRAY = np.asarray(LABELS)\n","DATASET_ID = \"NIH_CXR14\"\n","SPLIT_ID = \"NIH_OFFICIAL_PV\"\n","SEED = 42\n","VAL_FRACTION = 0.15\n","EXPECTED_COUNTS = {\"train\": 73916, \"val\": 12608, \"test\": 25596}\n","EXPECTED_LIST_COUNTS = {\"train_val_list.txt\": 86524, \"test_list.txt\": 25596}\n","EXPECTED_LIST_SHA256 = {\n","    \"train_val_list.txt\": \"61fbe896321c1c1c8b75f3e4f3a08e4fef6486d95ef8a667c31d4d60dca6cb81\",\n","    \"test_list.txt\": \"38ca5ef7f756092946f57c1a59faca882ed589a1ab1f72590b45dc06c6d5e1cc\",\n","}\n","EXPECTED_SPLIT_SHA256 = \"b9f2fbc9aa061dafa76994494b92779651dc3ddd2ed3e7b82c70bbf5cf7071dd\"\n","\n","RESNET_ID = \"M08_RESNET50_ASL_384_CR\"\n","RESNET_SHA256 = \"0a52192ad1c569e74865fd0c2e42cdb457826098129a9a183075c9c23d4d6625\"\n","BIOVIL_ID = \"M11_BIOVIL_T_448_CR\"\n","BIOVIL_SHA256 = \"0d067766186441e2163326a8c650081ba0aa7022705f27f1e677ddf09f17ddb3\"\n","BIOVIL_HUB_ID = \"microsoft/BiomedVLP-BioViL-T\"\n","BIOVIL_REVISION = \"v1.0\"\n","\n","STUDENT_ID = \"M10_RESNET50_BIOVIL_T_KD_384\"\n","KD_LAMBDA = 0.5\n","GO_MAX_TRAIN_AUROC = 0.95\n","TEACHER_DEFINITION = \"mean of validation-calibrated ResNet50 and BioViL-T probabilities\"\n","EXPECTED_TEACHER_MEMBERS = {\n","    \"ResNet50\": RESNET_SHA256,\n","    \"BioViL-T\": BIOVIL_SHA256,\n","}\n","BOOTSTRAP_RESAMPLES = 1000\n","BOOTSTRAP_SEED = 20260922\n","NUM_WORKERS = 2\n","STUDENT_CONFIG = {\n","    \"timm_name\": \"resnet50.tv_in1k\",\n","    \"drop_path_rate\": 0.1,\n","    \"img_size\": 384,\n","    \"batch_size\": 32,\n","    \"mean\": (0.485, 0.456, 0.406),\n","    \"std\": (0.229, 0.224, 0.225),\n","    \"warmup_epochs\": 1,\n","    \"finetune_epochs\": 8,\n","    \"patience\": 2,\n","    \"lr_head_warmup\": 1e-3,\n","    \"lr_head\": 1e-4,\n","    \"lr_backbone\": 1e-4,\n","    \"weight_decay\": 0.05,\n","    \"grad_clip_norm\": 1.0,\n","    \"asl\": {\"gamma_neg\": 4, \"gamma_pos\": 1, \"clip\": 0.05},\n","}\n","\n","\n","def sha256_file(path):\n","    digest = hashlib.sha256()\n","    with open(path, \"rb\") as stream:\n","        for block in iter(lambda: stream.read(1024 * 1024), b\"\"):\n","            digest.update(block)\n","    return digest.hexdigest()\n","\n","\n","def sha256_text(text):\n","    return hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\n","\n","\n","def set_determinism():\n","    random.seed(SEED)\n","    np.random.seed(SEED)\n","    torch.manual_seed(SEED)\n","    if torch.cuda.is_available():\n","        torch.cuda.manual_seed_all(SEED)\n","    torch.backends.cudnn.deterministic = True\n","    torch.backends.cudnn.benchmark = False\n","    torch.use_deterministic_algorithms(True, warn_only=True)\n","\n","\n","def worker_init_fn(_worker_id):\n","    worker_seed = torch.initial_seed() % (2**32)\n","    np.random.seed(worker_seed)\n","    random.seed(worker_seed)\n","\n","\n","def _find_files(root, wanted):\n","    found = {name: [] for name in wanted}\n","    for current, dirs, files in os.walk(root):\n","        dirs[:] = [name for name in dirs if not name.startswith(\"images\")]\n","        for name in wanted:\n","            if name in files:\n","                found[name].append(Path(current) / name)\n","        if all(found.values()):\n","            break\n","    return found\n","\n","\n","def locate_data(input_dir, data_root=None):\n","    search_root = Path(input_dir).expanduser().resolve()\n","    root = Path(data_root).expanduser().resolve() if data_root else search_root\n","    wanted = {\"Data_Entry_2017.csv\", \"train_val_list.txt\", \"test_list.txt\"}\n","    found = _find_files(root, wanted)\n","    metadata_paths = found[\"Data_Entry_2017.csv\"]\n","    if not metadata_paths:\n","        raise FileNotFoundError(\n","            f\"NIH metadata not found under {root}; attach NIH ChestX-ray14 or set --data-root.\"\n","        )\n","    if len(metadata_paths) != 1:\n","        raise ValueError(\n","            f\"Found {len(metadata_paths)} metadata files under {root}; set --data-root to choose one.\"\n","        )\n","\n","    metadata = metadata_paths[0]\n","    list_paths = {}\n","    for name in (\"train_val_list.txt\", \"test_list.txt\"):\n","        candidates = found[name]\n","        sibling = [path for path in candidates if path.parent == metadata.parent]\n","        if sibling:\n","            list_paths[name] = sibling[0]\n","        elif len(candidates) == 1:\n","            list_paths[name] = candidates[0]\n","        else:\n","            raise FileNotFoundError(\n","                f\"Cannot uniquely locate official {name} under {root}; set --data-root.\"\n","            )\n","    return metadata.parent, metadata, list_paths\n","\n","\n","def read_official_ids(path, expected_count, expected_hash):\n","    ids = Path(path).read_text(encoding=\"utf-8\").split()\n","    if len(ids) != expected_count or len(ids) != len(set(ids)):\n","        raise ValueError(f\"QC-01: unexpected count or duplicate IDs in {path}\")\n","    if sha256_text(\"\\n\".join(sorted(ids))) != expected_hash:\n","        raise ValueError(f\"QC-01: official-list hash mismatch for {path}\")\n","    return ids\n","\n","\n","def load_protocol_data(input_dir, data_root, output_dir):\n","    data_root, metadata_path, list_paths = locate_data(input_dir, data_root)\n","    frame = pd.read_csv(metadata_path)\n","    required = {\"Image Index\", \"Patient ID\", \"Finding Labels\"}\n","    missing_columns = required - set(frame.columns)\n","    if missing_columns:\n","        raise ValueError(f\"NIH metadata is missing columns: {sorted(missing_columns)}\")\n","    if len(frame) != 112120:\n","        raise ValueError(f\"Expected 112120 metadata rows; found {len(frame)}\")\n","\n","    frame[\"Image Index\"] = frame[\"Image Index\"].astype(str)\n","    frame = frame.sort_values(\"Image Index\").reset_index(drop=True)\n","    findings = frame[\"Finding Labels\"].fillna(\"\").str.split(\"|\")\n","    for label in LABELS:\n","        frame[label] = findings.map(lambda row, name=label: float(name in row))\n","\n","    train_val_ids = read_official_ids(\n","        list_paths[\"train_val_list.txt\"],\n","        EXPECTED_LIST_COUNTS[\"train_val_list.txt\"],\n","        EXPECTED_LIST_SHA256[\"train_val_list.txt\"],\n","    )\n","    test_ids = read_official_ids(\n","        list_paths[\"test_list.txt\"],\n","        EXPECTED_LIST_COUNTS[\"test_list.txt\"],\n","        EXPECTED_LIST_SHA256[\"test_list.txt\"],\n","    )\n","    if set(train_val_ids) & set(test_ids):\n","        raise ValueError(\"QC-01: official train_val and test lists overlap\")\n","    if set(train_val_ids) | set(test_ids) != set(frame[\"Image Index\"]):\n","        raise ValueError(\"QC-01: official lists do not exactly cover NIH metadata\")\n","\n","    frame[\"partition\"] = np.where(frame[\"Image Index\"].isin(test_ids), \"test\", \"trainval\")\n","    train_val = frame.loc[frame[\"partition\"] == \"trainval\"]\n","    _, val_indices = next(\n","        GroupShuffleSplit(n_splits=1, test_size=VAL_FRACTION, random_state=SEED).split(\n","            train_val, groups=train_val[\"Patient ID\"]\n","        )\n","    )\n","    frame.loc[frame[\"partition\"] == \"trainval\", \"partition\"] = \"train\"\n","    frame.loc[train_val.index[val_indices], \"partition\"] = \"val\"\n","\n","    split_frame = (\n","        frame[[\"Image Index\", \"Patient ID\", \"partition\"]]\n","        .rename(columns={\"Image Index\": \"image_index\", \"Patient ID\": \"patient_id\"})\n","        .sort_values(\"image_index\")\n","    )\n","    split_hash = sha256_text(split_frame.to_csv(index=False, lineterminator=\"\\n\"))\n","    if split_hash != EXPECTED_SPLIT_SHA256:\n","        raise ValueError(\n","            f\"QC-03: split hash mismatch (expected {EXPECTED_SPLIT_SHA256}, got {split_hash}); \"\n","            \"check scikit-learn==1.6.1.\"\n","        )\n","    counts = frame[\"partition\"].value_counts().to_dict()\n","    if counts != EXPECTED_COUNTS:\n","        raise ValueError(f\"QC-01: unexpected split counts: {counts}\")\n","    patients = {\n","        part: set(frame.loc[frame[\"partition\"] == part, \"Patient ID\"])\n","        for part in (\"train\", \"val\", \"test\")\n","    }\n","    if (\n","        patients[\"train\"] & patients[\"val\"]\n","        or patients[\"train\"] & patients[\"test\"]\n","        or patients[\"val\"] & patients[\"test\"]\n","    ):\n","        raise ValueError(\"QC-02: patient appears in multiple partitions\")\n","\n","    image_paths = {}\n","    for current, _, files in os.walk(data_root):\n","        for name in files:\n","            if name.endswith(\".png\"):\n","                image_paths.setdefault(name, str(Path(current) / name))\n","    frame[\"path\"] = frame[\"Image Index\"].map(image_paths)\n","    if frame[\"path\"].isna().any():\n","        raise FileNotFoundError(f\"QC-04: {int(frame['path'].isna().sum())} NIH PNGs are missing\")\n","\n","    Path(output_dir).mkdir(parents=True, exist_ok=True)\n","    split_frame.to_csv(\n","        Path(output_dir) / f\"split_{SPLIT_ID}.csv\", index=False, lineterminator=\"\\n\"\n","    )\n","    parts = {\n","        part: frame.loc[frame[\"partition\"] == part].reset_index(drop=True)\n","        for part in (\"train\", \"val\", \"test\")\n","    }\n","    print(\n","        f\"Validated {SPLIT_ID}: train={len(parts['train'])}, \"\n","        f\"val={len(parts['val'])}, test={len(parts['test'])}; split={split_hash}\"\n","    )\n","    return parts, split_hash\n","\n","\n","def find_run_dir(input_dir, model_id, checkpoint_sha256):\n","    prefix = f\"{DATASET_ID}__{SPLIT_ID}__{model_id}__\"\n","    matches = []\n","    wrong_hashes = []\n","    for root, dirs, files in os.walk(input_dir):\n","        dirs[:] = [name for name in dirs if not name.startswith(\"images\")]\n","        if (\n","            Path(root).name.startswith(prefix)\n","            and \"checkpoint_best.pt\" in files\n","            and \"logits_val.npz\" in files\n","            and \"logits_test.npz\" in files\n","        ):\n","            checkpoint = Path(root) / \"checkpoint_best.pt\"\n","            actual_hash = sha256_file(checkpoint)\n","            if actual_hash == checkpoint_sha256:\n","                matches.append(Path(root))\n","            else:\n","                wrong_hashes.append((str(checkpoint), actual_hash))\n","    if len(matches) != 1:\n","        if not matches and wrong_hashes:\n","            detail = \"; \".join(f\"{path} sha256={digest}\" for path, digest in wrong_hashes)\n","            raise ValueError(\n","                f\"No matching pinned {model_id} result checkpoint. Found different checkpoint(s): \"\n","                f\"{detail}. Attach the current single-model result bundle.\"\n","            )\n","        raise FileNotFoundError(\n","            f\"Expected exactly one {model_id} result folder with the pinned checkpoint \"\n","            f\"{checkpoint_sha256}; found {len(matches)}.\"\n","        )\n","    return matches[0]\n","\n","\n","def load_npz(path):\n","    return np.load(path, allow_pickle=False)\n","\n","\n","def _scalar_text(value):\n","    item = np.asarray(value).item()\n","    return item.decode(\"utf-8\") if isinstance(item, bytes) else str(item)\n","\n","\n","def _label_order(archive):\n","    values = archive[\"label_order\"]\n","    if values.shape == ():\n","        raw = _scalar_text(values)\n","        try:\n","            return json.loads(raw)\n","        except json.JSONDecodeError:\n","            return [raw]\n","    return [str(value) for value in values.tolist()]\n","\n","\n","def validate_saved_logits(run_dir, part, frame, split_hash):\n","    archive = load_npz(run_dir / f\"logits_{part}.npz\")\n","    ids = frame[\"Image Index\"].to_numpy(dtype=str)\n","    labels = frame[LABELS].to_numpy(dtype=np.uint8)\n","    if _label_order(archive) != LABELS:\n","        raise ValueError(f\"QC-05: label order mismatch in {run_dir}/logits_{part}.npz\")\n","    if _scalar_text(archive[\"split_sha256\"]) != split_hash:\n","        raise ValueError(f\"QC-03: split hash mismatch in {run_dir}/logits_{part}.npz\")\n","    if not np.array_equal(archive[\"image_index\"].astype(str), ids):\n","        raise ValueError(f\"QC-04: image order mismatch in {run_dir}/logits_{part}.npz\")\n","    if not np.array_equal(archive[\"labels\"].astype(np.uint8), labels):\n","        raise ValueError(f\"QC-04: labels mismatch in {run_dir}/logits_{part}.npz\")\n","    return {\n","        \"image_index\": ids,\n","        \"patient_id\": frame[\"Patient ID\"].to_numpy(dtype=np.int64),\n","        \"logits\": archive[\"logits\"].astype(np.float32),\n","        \"labels\": labels,\n","        \"label_order\": LABEL_ARRAY,\n","        \"split_sha256\": np.asarray(split_hash),\n","    }\n","\n","\n","def load_rebuilt_teacher_logits(path, frame, split_hash, checkpoint_sha256):\n","    archive = load_npz(path)\n","    if (\n","        not np.array_equal(\n","            archive[\"image_index\"].astype(str),\n","            frame[\"Image Index\"].to_numpy(dtype=str),\n","        )\n","        or _scalar_text(archive[\"split_sha256\"]) != split_hash\n","        or _label_order(archive) != LABELS\n","        or (\n","            \"checkpoint_sha256\" in archive\n","            and _scalar_text(archive[\"checkpoint_sha256\"]) != checkpoint_sha256\n","        )\n","    ):\n","        raise ValueError(f\"Cached teacher logits do not match the pinned data/model: {path}\")\n","    logits = archive[\"logits\"].astype(np.float32)\n","    if logits.shape != (len(frame), len(LABELS)):\n","        raise ValueError(f\"Cached teacher logits have an unexpected shape: {path}\")\n","    if \"labels\" in archive and not np.array_equal(\n","        archive[\"labels\"].astype(np.uint8),\n","        frame[LABELS].to_numpy(dtype=np.uint8),\n","    ):\n","        raise ValueError(f\"Cached teacher labels differ from the validated split: {path}\")\n","    return logits\n","\n","\n","def _save_logits(path, frame, logits, split_hash):\n","    np.savez_compressed(\n","        path,\n","        image_index=frame[\"Image Index\"].to_numpy(dtype=str),\n","        patient_id=frame[\"Patient ID\"].to_numpy(dtype=np.int64),\n","        logits=logits.astype(np.float32),\n","        labels=frame[LABELS].to_numpy(dtype=np.uint8),\n","        label_order=LABEL_ARRAY,\n","        split_sha256=np.asarray(split_hash),\n","    )\n","\n","\n","class CXRDataset(Dataset):\n","    def __init__(self, frame, img_size, mean, std, training=False, targets=None):\n","        self.frame = frame.reset_index(drop=True)\n","        self.labels = (\n","            self.frame[LABELS].to_numpy(dtype=np.float32)\n","            if targets is None\n","            else np.asarray(targets, dtype=np.float32)\n","        )\n","        if len(self.labels) != len(self.frame):\n","            raise ValueError(\"Training targets are not aligned with the image frame\")\n","        self.transform = (\n","            T.Compose(\n","                [\n","                    T.RandomResizedCrop(\n","                        img_size,\n","                        scale=(0.85, 1.0),\n","                        ratio=(0.9, 1.1),\n","                        interpolation=T.InterpolationMode.BILINEAR,\n","                    ),\n","                    T.RandomHorizontalFlip(p=0.5),\n","                    T.RandomApply([T.RandomRotation(7)], p=0.5),\n","                    T.ColorJitter(brightness=0.1, contrast=0.1),\n","                    T.ToTensor(),\n","                ]\n","            )\n","            if training\n","            else T.Compose(\n","                [\n","                    T.Resize(\n","                        (img_size, img_size),\n","                        interpolation=T.InterpolationMode.BILINEAR,\n","                    ),\n","                    T.ToTensor(),\n","                ]\n","            )\n","        )\n","        self.normalize = T.Normalize(mean, std)\n","\n","    def __len__(self):\n","        return len(self.frame)\n","\n","    def __getitem__(self, index):\n","        row = self.frame.iloc[index]\n","        with Image.open(row[\"path\"]) as source:\n","            image = source.convert(\"L\")\n","            tensor = self.transform(image).repeat(3, 1, 1)\n","        return self.normalize(tensor), self.labels[index]\n","\n","\n","class BioViLDataset(Dataset):\n","    def __init__(self, frame):\n","        self.frame = frame.reset_index(drop=True)\n","        self.labels = self.frame[LABELS].to_numpy(dtype=np.float32)\n","        self.transform = T.Compose([\n","            T.Resize(512, interpolation=T.InterpolationMode.BILINEAR),\n","            T.CenterCrop(448),\n","            T.ToTensor(),\n","        ])\n","\n","    def __len__(self):\n","        return len(self.frame)\n","\n","    def __getitem__(self, index):\n","        row = self.frame.iloc[index]\n","        with Image.open(row[\"path\"]) as source:\n","            pixels = self.transform(source.convert(\"L\")).repeat(3, 1, 1)\n","        return pixels, self.labels[index]\n","\n","\n","def make_loader(frame, training=False, targets=None, batch_size=None):\n","    dataset = CXRDataset(\n","        frame,\n","        STUDENT_CONFIG[\"img_size\"],\n","        STUDENT_CONFIG[\"mean\"],\n","        STUDENT_CONFIG[\"std\"],\n","        training=training,\n","        targets=targets,\n","    )\n","    generator = torch.Generator().manual_seed(SEED)\n","    return DataLoader(\n","        dataset,\n","        batch_size=batch_size or STUDENT_CONFIG[\"batch_size\"],\n","        shuffle=training,\n","        num_workers=NUM_WORKERS,\n","        pin_memory=torch.cuda.is_available(),\n","        persistent_workers=NUM_WORKERS > 0,\n","        worker_init_fn=worker_init_fn,\n","        generator=generator,\n","    )\n","\n","\n","class ResNetClassifier(nn.Module):\n","    def __init__(self, pretrained=True):\n","        super().__init__()\n","        import timm\n","\n","        self.backbone = timm.create_model(\n","            STUDENT_CONFIG[\"timm_name\"], pretrained=pretrained, num_classes=0,\n","            drop_path_rate=STUDENT_CONFIG[\"drop_path_rate\"],\n","        )\n","        self.head = nn.Sequential(\n","            nn.Dropout(p=0.2),\n","            nn.Linear(self.backbone.num_features, len(LABELS)),\n","        )\n","\n","    def forward(self, images):\n","        return self.head(self.backbone(images))\n","\n","\n","class BioViLClassifier(nn.Module):\n","    def __init__(self, backbone):\n","        super().__init__()\n","        self.backbone = backbone\n","        self.head = nn.Sequential(nn.Dropout(p=0.2), nn.Linear(512, len(LABELS)))\n","\n","    def forward(self, images):\n","        return self.head(self.backbone(images).img_embedding)\n","\n","\n","class AsymmetricLoss(nn.Module):\n","    def __init__(self, gamma_neg=4, gamma_pos=1, clip=0.05, eps=1e-8):\n","        super().__init__()\n","        self.gamma_neg = gamma_neg\n","        self.gamma_pos = gamma_pos\n","        self.clip = clip\n","        self.eps = eps\n","\n","    def forward(self, logits, targets):\n","        probabilities = torch.sigmoid(logits.float())\n","        negative = (\n","            (probabilities - self.clip).clamp(min=0)\n","            if self.clip > 0\n","            else probabilities\n","        )\n","        positive_loss = (\n","            targets\n","            * torch.log(probabilities.clamp(min=self.eps))\n","            * (1 - probabilities).pow(self.gamma_pos)\n","        )\n","        negative_loss = (\n","            (1 - targets)\n","            * torch.log((1 - negative).clamp(min=self.eps))\n","            * negative.pow(self.gamma_neg)\n","        )\n","        return -(positive_loss + negative_loss).sum(dim=1).mean()\n","\n","\n","DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","USE_AMP = DEVICE.type == \"cuda\"\n","\n","\n","def predict_logits(model, loader):\n","    model.eval()\n","    outputs = []\n","    with torch.inference_mode():\n","        for images, _ in loader:\n","            images = images.to(DEVICE, non_blocking=True)\n","            with torch.autocast(\n","                device_type=DEVICE.type,\n","                dtype=torch.float16,\n","                enabled=USE_AMP,\n","            ):\n","                logits = model(images)\n","            outputs.append(logits.float().cpu().numpy())\n","    return np.concatenate(outputs).astype(np.float32)\n","\n","\n","def macro_auroc(labels, scores):\n","    values = [\n","        roc_auc_score(labels[:, index], scores[:, index])\n","        for index in range(labels.shape[1])\n","        if 0 < labels[:, index].sum() < len(labels)\n","    ]\n","    if not values:\n","        raise ValueError(\"Macro AUROC is undefined: no label has both classes\")\n","    return float(np.mean(values))\n","\n","\n","def load_teacher_calibration(run_dir):\n","    calibration = json.loads((run_dir / \"calibration.json\").read_text(encoding=\"utf-8\"))\n","    if calibration.get(\"label_order\") != LABELS:\n","        raise ValueError(f\"Teacher calibration label order differs from the protocol: {run_dir}\")\n","    params = calibration.get(\"parameters\")\n","    if not isinstance(params, list) or len(params) != len(LABELS):\n","        raise ValueError(f\"Unsupported teacher calibration format in {run_dir}\")\n","    return np.asarray([[item[\"a\"], item[\"b\"]] for item in params], dtype=np.float64)\n","\n","\n","def check_rebuilt_validation_logits(model_name, frame, rebuilt, saved):\n","    correlations = [\n","        np.corrcoef(rebuilt[:, index], saved[:, index])[0, 1]\n","        for index in range(len(LABELS))\n","    ]\n","    auc_delta = abs(\n","        macro_auroc(frame[LABELS].to_numpy(), rebuilt)\n","        - macro_auroc(frame[LABELS].to_numpy(), saved)\n","    )\n","    min_correlation = float(np.nanmin(correlations))\n","    if (\n","        not np.isfinite(min_correlation)\n","        or not np.isfinite(auc_delta)\n","        or min_correlation < 0.999\n","        or auc_delta > 0.001\n","    ):\n","        raise ValueError(\n","            f\"QC-D2 failed for {model_name}: min validation logit correlation=\"\n","            f\"{min_correlation:.6f}, macro-AUROC delta={auc_delta:.6f}; \"\n","            \"check preprocessing and checkpoint revision.\"\n","        )\n","    return min_correlation, auc_delta\n","\n","\n","def run_teacher(parts, split_hash, input_dir, output_dir):\n","    resnet_dir = find_run_dir(input_dir, RESNET_ID, RESNET_SHA256)\n","    teacher_dir = find_run_dir(input_dir, BIOVIL_ID, BIOVIL_SHA256)\n","    resnet_config = json.loads((resnet_dir / \"config.json\").read_text(encoding=\"utf-8\"))\n","    biovil_config = json.loads((teacher_dir / \"config.json\").read_text(encoding=\"utf-8\"))\n","    if (\n","        resnet_config.get(\"model_id\") != RESNET_ID\n","        or resnet_config.get(\"split_sha256\") != split_hash\n","    ):\n","        raise ValueError(f\"ResNet50 run configuration does not match the pinned result: {resnet_dir}\")\n","    if (\n","        biovil_config.get(\"model_id\") != BIOVIL_ID\n","        or biovil_config.get(\"split_sha256\") != split_hash\n","        or biovil_config.get(\"revision\") != BIOVIL_REVISION\n","    ):\n","        raise ValueError(f\"BioViL-T run configuration does not match the pinned result: {teacher_dir}\")\n","\n","    resnet_val_saved = validate_saved_logits(resnet_dir, \"val\", parts[\"val\"], split_hash)\n","    validate_saved_logits(resnet_dir, \"test\", parts[\"test\"], split_hash)\n","    val_saved = validate_saved_logits(teacher_dir, \"val\", parts[\"val\"], split_hash)\n","    validate_saved_logits(teacher_dir, \"test\", parts[\"test\"], split_hash)\n","\n","    started = time.time()\n","    teacher_output = output_dir / \"teacher\"\n","    teacher_output.mkdir(parents=True, exist_ok=True)\n","    train_labels = parts[\"train\"][LABELS].to_numpy(dtype=np.float32)\n","    train_probabilities = {}\n","    validation_checks = {}\n","    checkpoint_hashes = {}\n","\n","    cnn_train_cache = teacher_output / \"resnet50_logits_train.npz\"\n","    cnn_val_cache = teacher_output / \"resnet50_logits_val_rebuilt.npz\"\n","    if cnn_train_cache.exists() and cnn_val_cache.exists():\n","        cnn_train_logits = load_rebuilt_teacher_logits(\n","            cnn_train_cache, parts[\"train\"], split_hash, RESNET_SHA256\n","        )\n","        cnn_val_logits = load_rebuilt_teacher_logits(\n","            cnn_val_cache, parts[\"val\"], split_hash, RESNET_SHA256\n","        )\n","        print(\"Reusing validated ResNet50 teacher logits from the previous run.\")\n","    else:\n","        resnet_checkpoint = torch.load(\n","            resnet_dir / \"checkpoint_best.pt\",\n","            map_location=\"cpu\",\n","            weights_only=False,\n","        )\n","        if (\n","            resnet_checkpoint.get(\"model_id\") != RESNET_ID\n","            or resnet_checkpoint.get(\"split_sha256\") != split_hash\n","        ):\n","            raise ValueError(\"ResNet50 checkpoint metadata differs from the expected single-model run\")\n","        resnet_model = ResNetClassifier(pretrained=False).to(DEVICE)\n","        resnet_model.load_state_dict(resnet_checkpoint[\"model_state\"], strict=True)\n","        del resnet_checkpoint\n","        cnn_train_logits = predict_logits(\n","            resnet_model,\n","            make_loader(parts[\"train\"], batch_size=resnet_config.get(\"batch_size\", 32)),\n","        )\n","        cnn_val_logits = predict_logits(\n","            resnet_model,\n","            make_loader(parts[\"val\"], batch_size=resnet_config.get(\"batch_size\", 32) * 2),\n","        )\n","        np.savez_compressed(\n","            cnn_train_cache,\n","            image_index=parts[\"train\"][\"Image Index\"].to_numpy(dtype=str),\n","            patient_id=parts[\"train\"][\"Patient ID\"].to_numpy(dtype=np.int64),\n","            logits=cnn_train_logits,\n","            labels=train_labels.astype(np.uint8),\n","            label_order=LABEL_ARRAY,\n","            checkpoint_sha256=RESNET_SHA256,\n","            split_sha256=split_hash,\n","        )\n","        np.savez_compressed(\n","            cnn_val_cache,\n","            image_index=parts[\"val\"][\"Image Index\"].to_numpy(dtype=str),\n","            logits=cnn_val_logits,\n","            label_order=LABEL_ARRAY,\n","            checkpoint_sha256=RESNET_SHA256,\n","            split_sha256=split_hash,\n","        )\n","        del resnet_model\n","    cnn_corr, cnn_auc_delta = check_rebuilt_validation_logits(\n","        \"ResNet50\", parts[\"val\"], cnn_val_logits, resnet_val_saved[\"logits\"]\n","    )\n","    validation_checks[\"ResNet50\"] = {\n","        \"min_logit_correlation\": cnn_corr,\n","        \"macro_auroc_absolute_delta\": cnn_auc_delta,\n","    }\n","    cnn_calibration = load_teacher_calibration(resnet_dir)\n","    train_probabilities[\"ResNet50\"] = expit(\n","        cnn_train_logits * cnn_calibration[None, :, 0] + cnn_calibration[None, :, 1]\n","    ).astype(np.float32)\n","    checkpoint_hashes[\"ResNet50\"] = RESNET_SHA256\n","    del cnn_train_logits, cnn_val_logits\n","    if USE_AMP:\n","        torch.cuda.empty_cache()\n","\n","    biovil_train_cache = teacher_output / \"biovil_t_logits_train.npz\"\n","    biovil_val_cache = teacher_output / \"biovil_t_logits_val_rebuilt.npz\"\n","    if biovil_train_cache.exists() and biovil_val_cache.exists():\n","        biovil_train_logits = load_rebuilt_teacher_logits(\n","            biovil_train_cache, parts[\"train\"], split_hash, BIOVIL_SHA256\n","        )\n","        biovil_val_logits = load_rebuilt_teacher_logits(\n","            biovil_val_cache, parts[\"val\"], split_hash, BIOVIL_SHA256\n","        )\n","        print(\"Reusing validated BioViL-T teacher logits from the previous run.\")\n","    else:\n","        biovil_checkpoint = torch.load(\n","            teacher_dir / \"checkpoint_best.pt\", map_location=\"cpu\", weights_only=False\n","        )\n","        if (\n","            biovil_checkpoint.get(\"model_id\") != BIOVIL_ID\n","            or biovil_checkpoint.get(\"split_sha256\") != split_hash\n","        ):\n","            raise ValueError(\"BioViL-T checkpoint metadata differs from the expected single-model run\")\n","        from health_multimodal.image.model.pretrained import get_biovil_t_image_encoder\n","\n","        model = BioViLClassifier(get_biovil_t_image_encoder()).to(DEVICE)\n","        model.load_state_dict(biovil_checkpoint[\"model_state\"], strict=True)\n","        del biovil_checkpoint\n","        model.eval()\n","        batch_size = biovil_config.get(\"batch_size\", 12)\n","        train_loader = DataLoader(\n","            BioViLDataset(parts[\"train\"]), batch_size=batch_size, shuffle=False,\n","            num_workers=NUM_WORKERS, pin_memory=USE_AMP,\n","            persistent_workers=NUM_WORKERS > 0,\n","        )\n","        val_loader = DataLoader(\n","            BioViLDataset(parts[\"val\"]), batch_size=batch_size, shuffle=False,\n","            num_workers=NUM_WORKERS, pin_memory=USE_AMP,\n","            persistent_workers=NUM_WORKERS > 0,\n","        )\n","        biovil_train_logits = predict_logits(model, train_loader)\n","        biovil_val_logits = predict_logits(model, val_loader)\n","        np.savez_compressed(\n","            biovil_train_cache,\n","            image_index=parts[\"train\"][\"Image Index\"].to_numpy(dtype=str),\n","            patient_id=parts[\"train\"][\"Patient ID\"].to_numpy(dtype=np.int64),\n","            logits=biovil_train_logits, labels=train_labels.astype(np.uint8),\n","            label_order=LABEL_ARRAY, checkpoint_sha256=BIOVIL_SHA256,\n","            split_sha256=split_hash,\n","        )\n","        np.savez_compressed(\n","            biovil_val_cache,\n","            image_index=parts[\"val\"][\"Image Index\"].to_numpy(dtype=str),\n","            logits=biovil_val_logits, label_order=LABEL_ARRAY,\n","            checkpoint_sha256=BIOVIL_SHA256, split_sha256=split_hash,\n","        )\n","        del model\n","    biovil_corr, biovil_auc_delta = check_rebuilt_validation_logits(\n","        \"BioViL-T\", parts[\"val\"], biovil_val_logits, val_saved[\"logits\"]\n","    )\n","    validation_checks[\"BioViL-T\"] = {\n","        \"min_logit_correlation\": biovil_corr,\n","        \"macro_auroc_absolute_delta\": biovil_auc_delta,\n","    }\n","    biovil_calibration = load_teacher_calibration(teacher_dir)\n","    train_probabilities[\"BioViL-T\"] = expit(\n","        biovil_train_logits * biovil_calibration[None, :, 0]\n","        + biovil_calibration[None, :, 1]\n","    ).astype(np.float32)\n","    checkpoint_hashes[\"BioViL-T\"] = BIOVIL_SHA256\n","    del biovil_train_logits, biovil_val_logits\n","    if USE_AMP:\n","        torch.cuda.empty_cache()\n","\n","    soft_labels = np.mean(\n","        [train_probabilities[\"ResNet50\"], train_probabilities[\"BioViL-T\"]],\n","        axis=0,\n","    ).astype(np.float32)\n","    teacher_train_auc = macro_auroc(train_labels, soft_labels)\n","    decision = \"go\" if teacher_train_auc < GO_MAX_TRAIN_AUROC else \"stop\"\n","    np.savez_compressed(\n","        output_dir / \"soft_labels_train.npz\",\n","        image_index=parts[\"train\"][\"Image Index\"].to_numpy(dtype=str),\n","        q=soft_labels,\n","        labels=train_labels.astype(np.uint8),\n","        label_order=LABEL_ARRAY,\n","        kd_lambda=KD_LAMBDA,\n","        teacher_members=json.dumps(checkpoint_hashes, sort_keys=True),\n","        split_sha256=split_hash,\n","    )\n","    go_no_go = {\n","        \"student_id\": STUDENT_ID,\n","        \"teacher_definition\": TEACHER_DEFINITION,\n","        \"teacher_members\": checkpoint_hashes,\n","        \"teacher_train_macro_auroc\": {\n","            \"ResNet50\": macro_auroc(train_labels, train_probabilities[\"ResNet50\"]),\n","            \"BioViL-T\": macro_auroc(train_labels, train_probabilities[\"BioViL-T\"]),\n","            \"ensemble\": teacher_train_auc,\n","        },\n","        \"threshold\": GO_MAX_TRAIN_AUROC,\n","        \"decision\": decision,\n","        \"split_sha256\": split_hash,\n","        \"soft_label_count\": len(soft_labels),\n","        \"validation_reproduction\": validation_checks,\n","        \"teacher_soft_label_minutes\": (time.time() - started) / 60,\n","    }\n","    (output_dir / \"distill_go_no_go.json\").write_text(\n","        json.dumps(go_no_go, indent=2), encoding=\"utf-8\"\n","    )\n","    (output_dir / \"qc_session_D.json\").write_text(\n","        json.dumps(\n","            {\n","                \"QC-D1\": f\"pass ({checkpoint_hashes})\",\n","                \"QC-D2\": f\"pass ({validation_checks})\",\n","                \"QC-D3\": \"pass (train-only soft labels)\",\n","            },\n","            indent=2,\n","        ),\n","        encoding=\"utf-8\",\n","    )\n","    print(\n","        f\"Ensemble teacher train macro AUROC={teacher_train_auc:.4f}; \"\n","        f\"go/no-go={decision.upper()}; soft-label pass={go_no_go['teacher_soft_label_minutes']:.1f} min\"\n","    )\n","    return decision\n","\n","\n","def _cosine_schedule(optimizer, total_steps):\n","    warmup_steps = max(1, int(total_steps * 0.03))\n","\n","    def scale(step):\n","        if step < warmup_steps:\n","            return (step + 1) / warmup_steps\n","        return 0.5 * (1 + np.cos(np.pi * (step - warmup_steps) / max(1, total_steps - warmup_steps)))\n","\n","    return torch.optim.lr_scheduler.LambdaLR(optimizer, scale)\n","\n","\n","def _student_optimizer(model, phase):\n","    for parameter in model.parameters():\n","        parameter.requires_grad = False\n","    for parameter in model.head.parameters():\n","        parameter.requires_grad = True\n","    head_lr = (\n","        STUDENT_CONFIG[\"lr_head_warmup\"]\n","        if phase == \"warmup\"\n","        else STUDENT_CONFIG[\"lr_head\"]\n","    )\n","    groups = [{\"params\": list(model.head.parameters()), \"lr\": head_lr}]\n","    if phase == \"finetune\":\n","        for parameter in model.backbone.parameters():\n","            parameter.requires_grad = True\n","        groups.append(\n","            {\n","                \"params\": list(model.backbone.parameters()),\n","                \"lr\": STUDENT_CONFIG[\"lr_backbone\"],\n","            }\n","        )\n","    return torch.optim.AdamW(groups, weight_decay=STUDENT_CONFIG[\"weight_decay\"])\n","\n","\n","def _clip_gradients_or_skip(parameters, scaler, max_norm):\n","    previous_scale = scaler.get_scale()\n","    total_norm = torch.nn.utils.clip_grad_norm_(\n","        parameters,\n","        max_norm,\n","        error_if_nonfinite=False,\n","    )\n","    if torch.isfinite(total_norm):\n","        return True\n","    if not USE_AMP:\n","        raise FloatingPointError(\"Non-finite student gradient norm without AMP.\")\n","\n","    scaler.update()\n","    if scaler.get_scale() >= previous_scale:\n","        raise FloatingPointError(\n","            \"Student gradient norm is non-finite, but GradScaler did not detect \"\n","            \"an AMP overflow. Check the loss, gradients, and learning rate.\"\n","        )\n","    return False\n","\n","\n","def run_student(parts, split_hash, output_dir):\n","    go_no_go = json.loads((output_dir / \"distill_go_no_go.json\").read_text(encoding=\"utf-8\"))\n","    if (\n","        go_no_go.get(\"teacher_definition\") != TEACHER_DEFINITION\n","        or go_no_go.get(\"teacher_members\") != EXPECTED_TEACHER_MEMBERS\n","        or go_no_go.get(\"split_sha256\") != split_hash\n","    ):\n","        raise ValueError(\"Saved go/no-go result is not for the pinned ResNet50 + BioViL-T ensemble.\")\n","    if go_no_go[\"decision\"] != \"go\":\n","        print(\n","            f\"Student not trained: ensemble teacher train macro AUROC \"\n","            f\"{go_no_go['teacher_train_macro_auroc']['ensemble']:.4f} meets/exceeds \"\n","            f\"the {GO_MAX_TRAIN_AUROC:.2f} stop threshold.\"\n","        )\n","        return False\n","\n","    soft = load_npz(output_dir / \"soft_labels_train.npz\")\n","    train_frame = parts[\"train\"]\n","    if (\n","        not np.array_equal(soft[\"image_index\"].astype(str), train_frame[\"Image Index\"].to_numpy(dtype=str))\n","        or _scalar_text(soft[\"split_sha256\"]) != split_hash\n","        or _label_order(soft) != LABELS\n","        or json.loads(_scalar_text(soft[\"teacher_members\"])) != EXPECTED_TEACHER_MEMBERS\n","    ):\n","        raise ValueError(\"QC-D3: soft-label order, split, or label order is invalid\")\n","    hard = train_frame[LABELS].to_numpy(dtype=np.float32)\n","    targets = ((1 - KD_LAMBDA) * hard + KD_LAMBDA * soft[\"q\"]).astype(np.float32)\n","    train_loader = make_loader(train_frame, training=True, targets=targets)\n","    val_loader = make_loader(parts[\"val\"], batch_size=STUDENT_CONFIG[\"batch_size\"] * 2)\n","\n","    model = ResNetClassifier(pretrained=True).to(DEVICE)\n","    loss_fn = AsymmetricLoss(**STUDENT_CONFIG[\"asl\"])\n","    scaler = torch.amp.GradScaler(\"cuda\", enabled=USE_AMP)\n","    run_dir = output_dir / f\"{DATASET_ID}__{SPLIT_ID}__{STUDENT_ID}__s{SEED}\"\n","    run_dir.mkdir(parents=True, exist_ok=True)\n","    best_auc = -np.inf\n","    best_epoch = 0\n","    bad_finetune_epochs = 0\n","    epoch_log = []\n","    started = time.time()\n","    plan = [(\"warmup\", STUDENT_CONFIG[\"warmup_epochs\"])] + [\n","        (\"finetune\", STUDENT_CONFIG[\"finetune_epochs\"])\n","    ]\n","    epoch = 0\n","    for phase, phase_epochs in plan:\n","        optimizer = _student_optimizer(model, phase)\n","        scheduler = _cosine_schedule(optimizer, len(train_loader) * phase_epochs)\n","        if phase == \"finetune\":\n","            bad_finetune_epochs = 0\n","        for phase_epoch in range(phase_epochs):\n","            epoch += 1\n","            model.train()\n","            running_loss = 0.0\n","            sample_count = 0\n","            optimizer_steps = 0\n","            skipped_overflow_batches = 0\n","            epoch_started = time.time()\n","            for images, targets_batch in train_loader:\n","                images = images.to(DEVICE, non_blocking=True)\n","                targets_batch = targets_batch.to(DEVICE, non_blocking=True)\n","                optimizer.zero_grad(set_to_none=True)\n","                with torch.autocast(\n","                    device_type=DEVICE.type,\n","                    dtype=torch.float16,\n","                    enabled=USE_AMP,\n","                ):\n","                    logits = model(images)\n","                    loss = loss_fn(logits, targets_batch)\n","                if not torch.isfinite(loss):\n","                    raise FloatingPointError(f\"Non-finite loss at epoch {epoch}\")\n","                scaler.scale(loss).backward()\n","                scaler.unscale_(optimizer)\n","                running_loss += float(loss.detach()) * len(images)\n","                sample_count += len(images)\n","                gradients_clipped = _clip_gradients_or_skip(\n","                    [parameter for parameter in model.parameters() if parameter.requires_grad],\n","                    scaler,\n","                    STUDENT_CONFIG[\"grad_clip_norm\"],\n","                )\n","                if not gradients_clipped:\n","                    skipped_overflow_batches += 1\n","                    continue\n","                scaler.step(optimizer)\n","                scaler.update()\n","                scheduler.step()\n","                optimizer_steps += 1\n","            if optimizer_steps == 0:\n","                raise FloatingPointError(\n","                    f\"No optimizer steps completed at epoch {epoch}; all batches \"\n","                    \"had non-finite gradients.\"\n","                )\n","            val_logits = predict_logits(model, val_loader)\n","            val_labels = parts[\"val\"][LABELS].to_numpy(dtype=np.uint8)\n","            val_auc = macro_auroc(val_labels, val_logits)\n","            epoch_log.append(\n","                {\n","                    \"epoch\": epoch,\n","                    \"phase\": phase,\n","                    \"phase_epoch\": phase_epoch + 1,\n","                    \"train_loss\": running_loss / max(1, sample_count),\n","                    \"val_macro_auroc\": val_auc,\n","                    \"skipped_overflow_batches\": skipped_overflow_batches,\n","                    \"epoch_seconds\": time.time() - epoch_started,\n","                }\n","            )\n","            print(\n","                f\"{STUDENT_ID} epoch {epoch}: loss={running_loss / max(1, sample_count):.5f} \"\n","                f\"val_macro_auroc={val_auc:.5f} best={max(best_auc, val_auc):.5f} \"\n","                f\"overflow_batches_skipped={skipped_overflow_batches}\",\n","                flush=True,\n","            )\n","            if val_auc > best_auc:\n","                best_auc = val_auc\n","                best_epoch = epoch\n","                bad_finetune_epochs = 0\n","                torch.save(\n","                    {\n","                        \"model_state\": model.state_dict(),\n","                        \"model_id\": STUDENT_ID,\n","                        \"split_sha256\": split_hash,\n","                        \"seed\": SEED,\n","                        \"best_epoch\": best_epoch,\n","                        \"best_val_macro_auroc\": best_auc,\n","                    },\n","                    run_dir / \"checkpoint_best.pt\",\n","                )\n","            elif phase == \"finetune\":\n","                bad_finetune_epochs += 1\n","                if bad_finetune_epochs >= STUDENT_CONFIG[\"patience\"]:\n","                    print(\"Early stopping after two non-improving fine-tuning epochs.\")\n","                    break\n","        if phase == \"finetune\" and bad_finetune_epochs >= STUDENT_CONFIG[\"patience\"]:\n","            break\n","\n","    checkpoint = torch.load(\n","        run_dir / \"checkpoint_best.pt\", map_location=DEVICE, weights_only=False\n","    )\n","    model.load_state_dict(checkpoint[\"model_state\"], strict=True)\n","    model.eval()\n","    for part in (\"val\", \"test\"):\n","        frame = parts[part]\n","        logits = predict_logits(\n","            model,\n","            make_loader(frame, batch_size=STUDENT_CONFIG[\"batch_size\"] * 2),\n","        )\n","        _save_logits(run_dir / f\"logits_{part}.npz\", frame, logits, split_hash)\n","    config = {\n","        \"model_id\": STUDENT_ID,\n","        \"dataset_id\": DATASET_ID,\n","        \"split_id\": SPLIT_ID,\n","        \"split_sha256\": split_hash,\n","        \"seed\": SEED,\n","        \"architecture\": STUDENT_CONFIG[\"timm_name\"],\n","        \"initialization\": \"ImageNet pretrained; not initialized from the single-model ResNet50 checkpoint\",\n","        \"input_size\": STUDENT_CONFIG[\"img_size\"],\n","        \"kd_lambda\": KD_LAMBDA,\n","        \"target\": \"(1 - kd_lambda) * hard_label + kd_lambda * mean(calibrated_ResNet50_probability, calibrated_BIOVIL_probability)\",\n","        \"teacher_definition\": TEACHER_DEFINITION,\n","        \"teacher_members\": go_no_go[\"teacher_members\"],\n","        \"best_epoch\": best_epoch,\n","        \"best_val_macro_auroc\": best_auc,\n","        \"epochs_trained\": len(epoch_log),\n","        \"train_wall_clock_seconds\": time.time() - started,\n","        \"student_config\": STUDENT_CONFIG,\n","    }\n","    (run_dir / \"config.json\").write_text(json.dumps(config, indent=2), encoding=\"utf-8\")\n","    pd.DataFrame(epoch_log).to_csv(run_dir / \"train_log.csv\", index=False)\n","    print(f\"Student checkpoint and validation/test logits written to {run_dir}\")\n","    del model\n","    if USE_AMP:\n","        torch.cuda.empty_cache()\n","    return True\n","\n","\n","def fit_platt(labels, logits):\n","    parameters = np.zeros((len(LABELS), 2), dtype=np.float64)\n","    for index, label in enumerate(LABELS):\n","        target = labels[:, index].astype(np.float64)\n","        raw = logits[:, index].astype(np.float64)\n","        if target.min() == target.max():\n","            raise ValueError(f\"Cannot calibrate {label}: validation labels are constant\")\n","\n","        def objective(coef):\n","            scaled = coef[0] * raw + coef[1]\n","            probabilities = expit(scaled)\n","            loss = np.logaddexp(0, scaled) - target * scaled\n","            residual = probabilities - target\n","            gradient = np.asarray([np.dot(residual, raw), residual.sum()])\n","            return float(loss.sum()), gradient\n","\n","        result = minimize(\n","            objective, np.asarray([1.0, 0.0]), method=\"L-BFGS-B\", jac=True\n","        )\n","        if not result.success or not np.isfinite(result.fun):\n","            raise RuntimeError(f\"Platt calibration failed for {label}: {result.message}\")\n","        parameters[index] = result.x\n","    return parameters\n","\n","\n","def fit_thresholds(labels, probabilities):\n","    thresholds = np.empty(len(LABELS), dtype=np.float64)\n","    for index in range(len(LABELS)):\n","        target = labels[:, index].astype(np.int64)\n","        scores = probabilities[:, index]\n","        if target.sum() == 0:\n","            thresholds[index] = 0.5\n","            continue\n","        order = np.argsort(scores, kind=\"mergesort\")[::-1]\n","        sorted_scores = scores[order]\n","        cumulative_tp = np.cumsum(target[order])\n","        ends = np.r_[np.flatnonzero(sorted_scores[:-1] != sorted_scores[1:]), len(scores) - 1]\n","        tp = cumulative_tp[ends]\n","        predicted = ends + 1\n","        fp = predicted - tp\n","        fn = target.sum() - tp\n","        f1 = np.divide(\n","            2 * tp,\n","            2 * tp + fp + fn,\n","            out=np.zeros_like(tp, dtype=np.float64),\n","            where=(2 * tp + fp + fn) > 0,\n","        )\n","        best = np.flatnonzero(f1 == f1.max())\n","        thresholds[index] = 0.5 if f1.max() == 0 else sorted_scores[ends[best[-1]]]\n","    return thresholds\n","\n","\n","def apply_calibration(logits, parameters):\n","    return expit(logits * parameters[None, :, 0] + parameters[None, :, 1])\n","\n","\n","def load_saved_calibration(run_dir):\n","    calibration = json.loads((run_dir / \"calibration.json\").read_text(encoding=\"utf-8\"))\n","    if calibration.get(\"label_order\") != LABELS:\n","        raise ValueError(f\"Calibration label order mismatch in {run_dir}\")\n","    parameters = np.asarray(\n","        [[item[\"a\"], item[\"b\"]] for item in calibration[\"parameters\"]],\n","        dtype=np.float64,\n","    )\n","    threshold_json = json.loads((run_dir / \"thresholds.json\").read_text(encoding=\"utf-8\"))\n","    if threshold_json.get(\"label_order\") != LABELS:\n","        raise ValueError(f\"Threshold label order mismatch in {run_dir}\")\n","    thresholds = np.asarray(\n","        [threshold_json[\"thresholds\"][label] for label in LABELS],\n","        dtype=np.float64,\n","    )\n","    return parameters, thresholds\n","\n","\n","def metrics(labels, probabilities, thresholds):\n","    truth = labels.astype(bool)\n","    predicted = probabilities >= thresholds[None, :]\n","    per_class = {}\n","    for index, label in enumerate(LABELS):\n","        actual = truth[:, index]\n","        scores = probabilities[:, index]\n","        auroc = (\n","            float(roc_auc_score(actual, scores))\n","            if actual.any() and (~actual).any()\n","            else float(\"nan\")\n","        )\n","        auprc = (\n","            float(average_precision_score(actual, scores))\n","            if actual.any() and (~actual).any()\n","            else float(\"nan\")\n","        )\n","        tp = int(np.sum(actual & predicted[:, index]))\n","        fp = int(np.sum(~actual & predicted[:, index]))\n","        fn = int(np.sum(actual & ~predicted[:, index]))\n","        precision = tp / (tp + fp) if tp + fp else 0.0\n","        recall = tp / (tp + fn) if tp + fn else float(\"nan\")\n","        f1 = 2 * tp / (2 * tp + fp + fn) if 2 * tp + fp + fn else 0.0\n","        per_class[label] = {\n","            \"auroc\": auroc,\n","            \"auprc\": auprc,\n","            \"f1\": f1,\n","            \"precision\": precision,\n","            \"recall\": recall,\n","            \"support\": int(actual.sum()),\n","        }\n","\n","    tp = int(np.sum(truth & predicted))\n","    fp = int(np.sum(~truth & predicted))\n","    fn = int(np.sum(truth & ~predicted))\n","    aggregate = {\n","        \"macro_auroc\": float(np.nanmean([item[\"auroc\"] for item in per_class.values()])),\n","        \"macro_auprc\": float(np.nanmean([item[\"auprc\"] for item in per_class.values()])),\n","        \"macro_f1\": float(np.mean([item[\"f1\"] for item in per_class.values()])),\n","        \"micro_f1\": 2 * tp / (2 * tp + fp + fn) if 2 * tp + fp + fn else 0.0,\n","        \"macro_precision\": float(np.mean([item[\"precision\"] for item in per_class.values()])),\n","        \"macro_recall\": float(np.nanmean([item[\"recall\"] for item in per_class.values()])),\n","    }\n","    return aggregate, per_class\n","\n","\n","def _bootstrap_ci(values):\n","    return [\n","        float(np.nanpercentile(values, 2.5)),\n","        float(np.nanpercentile(values, 97.5)),\n","    ]\n","\n","\n","def evaluate(parts, split_hash, input_dir, output_dir):\n","    baseline_dir = find_run_dir(input_dir, RESNET_ID, RESNET_SHA256)\n","    teacher_dir = find_run_dir(input_dir, BIOVIL_ID, BIOVIL_SHA256)\n","    systems = {}\n","    teacher_calibrations = {}\n","    for name, run_dir, model_id in (\n","        (\"ResNet50 baseline\", baseline_dir, RESNET_ID),\n","        (\"BioViL-T teacher\", teacher_dir, BIOVIL_ID),\n","    ):\n","        config = json.loads((run_dir / \"config.json\").read_text(encoding=\"utf-8\"))\n","        if (\n","            config.get(\"model_id\") != model_id\n","            or config.get(\"split_sha256\") != split_hash\n","        ):\n","            raise ValueError(f\"Single-model config does not match the NIH split: {run_dir}\")\n","        val = validate_saved_logits(run_dir, \"val\", parts[\"val\"], split_hash)\n","        test = validate_saved_logits(run_dir, \"test\", parts[\"test\"], split_hash)\n","        calibration, thresholds = load_saved_calibration(run_dir)\n","        teacher_calibrations[name] = calibration\n","        val_probabilities = apply_calibration(val[\"logits\"], calibration)\n","        test_probabilities = apply_calibration(test[\"logits\"], calibration)\n","        systems[name] = {\n","            \"val_probabilities\": val_probabilities,\n","            \"test_probabilities\": test_probabilities,\n","            \"thresholds\": thresholds,\n","        }\n","\n","    average_val = np.mean(\n","        [\n","            systems[\"ResNet50 baseline\"][\"val_probabilities\"],\n","            systems[\"BioViL-T teacher\"][\"val_probabilities\"],\n","        ],\n","        axis=0,\n","    )\n","    average_test = np.mean(\n","        [\n","            systems[\"ResNet50 baseline\"][\"test_probabilities\"],\n","            systems[\"BioViL-T teacher\"][\"test_probabilities\"],\n","        ],\n","        axis=0,\n","    )\n","    average_thresholds = fit_thresholds(\n","        parts[\"val\"][LABELS].to_numpy(dtype=np.uint8), average_val\n","    )\n","    systems[\"Teacher average (ResNet50 + BioViL-T)\"] = {\n","        \"val_probabilities\": average_val,\n","        \"test_probabilities\": average_test,\n","        \"thresholds\": average_thresholds,\n","    }\n","\n","    student_dir = output_dir / f\"{DATASET_ID}__{SPLIT_ID}__{STUDENT_ID}__s{SEED}\"\n","    val = validate_saved_logits(student_dir, \"val\", parts[\"val\"], split_hash)\n","    test = validate_saved_logits(student_dir, \"test\", parts[\"test\"], split_hash)\n","    val_labels = val[\"labels\"]\n","    student_calibration = fit_platt(val_labels, val[\"logits\"])\n","    student_val_probabilities = apply_calibration(val[\"logits\"], student_calibration)\n","    student_thresholds = fit_thresholds(val_labels, student_val_probabilities)\n","    systems[\"Distilled ResNet50\"] = {\n","        \"val_probabilities\": student_val_probabilities,\n","        \"test_probabilities\": apply_calibration(test[\"logits\"], student_calibration),\n","        \"thresholds\": student_thresholds,\n","    }\n","\n","    calibration_output = {\n","        \"label_order\": LABELS,\n","        \"systems\": {\n","            \"ResNet50 baseline\": {\n","                \"calibration\": [\n","                    {\"a\": float(a), \"b\": float(b)}\n","                    for a, b in teacher_calibrations[\"ResNet50 baseline\"]\n","                ],\n","                \"thresholds\": {\n","                    label: float(value)\n","                    for label, value in zip(\n","                        LABELS, systems[\"ResNet50 baseline\"][\"thresholds\"]\n","                    )\n","                },\n","            },\n","            \"BioViL-T teacher\": {\n","                \"calibration\": [\n","                    {\"a\": float(a), \"b\": float(b)}\n","                    for a, b in teacher_calibrations[\"BioViL-T teacher\"]\n","                ],\n","                \"thresholds\": {\n","                    label: float(value)\n","                    for label, value in zip(\n","                        LABELS, systems[\"BioViL-T teacher\"][\"thresholds\"]\n","                    )\n","                },\n","            },\n","            \"Teacher average (ResNet50 + BioViL-T)\": {\n","                \"calibration\": \"mean of the two teachers' validation-calibrated probabilities\",\n","                \"thresholds\": {\n","                    label: float(value)\n","                    for label, value in zip(LABELS, average_thresholds)\n","                },\n","            },\n","            \"Distilled ResNet50\": {\n","                \"calibration\": \"per-class Platt scaling fitted on validation only\",\n","                \"parameters\": [\n","                    {\"a\": float(a), \"b\": float(b)}\n","                    for a, b in student_calibration\n","                ],\n","                \"thresholds\": {\n","                    label: float(value)\n","                    for label, value in zip(LABELS, student_thresholds)\n","                },\n","            },\n","        },\n","        \"threshold_method\": \"per-class validation F1 maximization; ties choose smallest threshold\",\n","    }\n","    (output_dir / \"calibration_thresholds_distill.json\").write_text(\n","        json.dumps(calibration_output, indent=2), encoding=\"utf-8\"\n","    )\n","\n","    labels = test[\"labels\"]\n","    patient_ids = test[\"patient_id\"]\n","    point_metrics = {}\n","    per_class_metrics = {}\n","    for name, values in systems.items():\n","        point_metrics[name], per_class_metrics[name] = metrics(\n","            labels, values[\"test_probabilities\"], values[\"thresholds\"]\n","        )\n","\n","    unique_patients = np.unique(patient_ids)\n","    patient_rows = {patient: np.flatnonzero(patient_ids == patient) for patient in unique_patients}\n","    rng = np.random.RandomState(BOOTSTRAP_SEED)\n","    metric_names = list(next(iter(point_metrics.values())).keys())\n","    draws = {\n","        name: {metric_name: [] for metric_name in metric_names}\n","        for name in systems\n","    }\n","    deltas = {\n","        comparison: {metric_name: [] for metric_name in metric_names}\n","        for comparison in (\n","            \"student_minus_resnet\",\n","            \"student_minus_biovil_t\",\n","            \"student_minus_teacher_average\",\n","        )\n","    }\n","    comparison_systems = {\n","        \"student_minus_resnet\": (\"Distilled ResNet50\", \"ResNet50 baseline\"),\n","        \"student_minus_biovil_t\": (\"Distilled ResNet50\", \"BioViL-T teacher\"),\n","        \"student_minus_teacher_average\": (\n","            \"Distilled ResNet50\",\n","            \"Teacher average (ResNet50 + BioViL-T)\",\n","        ),\n","    }\n","    for _ in range(BOOTSTRAP_RESAMPLES):\n","        sampled = rng.choice(unique_patients, size=len(unique_patients), replace=True)\n","        indices = np.concatenate([patient_rows[patient] for patient in sampled])\n","        bootstrap_metrics = {}\n","        for name, values in systems.items():\n","            bootstrap_metrics[name], _ = metrics(\n","                labels[indices],\n","                values[\"test_probabilities\"][indices],\n","                values[\"thresholds\"],\n","            )\n","            for metric_name in metric_names:\n","                draws[name][metric_name].append(bootstrap_metrics[name][metric_name])\n","        for comparison, (left, right) in comparison_systems.items():\n","            for metric_name in metric_names:\n","                deltas[comparison][metric_name].append(\n","                    bootstrap_metrics[left][metric_name] - bootstrap_metrics[right][metric_name]\n","                )\n","\n","    results = {\n","        \"dataset_id\": DATASET_ID,\n","        \"split_id\": SPLIT_ID,\n","        \"split_sha256\": split_hash,\n","        \"seed\": SEED,\n","        \"tta\": \"none\",\n","        \"test_images\": int(len(labels)),\n","        \"test_patients\": int(len(unique_patients)),\n","        \"bootstrap\": {\n","            \"method\": \"patient-level percentile bootstrap\",\n","            \"resamples\": BOOTSTRAP_RESAMPLES,\n","            \"seed\": BOOTSTRAP_SEED,\n","        },\n","        \"systems\": {},\n","        \"paired_differences\": {},\n","    }\n","    for name in systems:\n","        results[\"systems\"][name] = {\n","            \"test_metrics\": point_metrics[name],\n","            \"test_metrics_95pct_patient_bootstrap_ci\": {\n","                metric_name: _bootstrap_ci(draws[name][metric_name])\n","                for metric_name in metric_names\n","            },\n","        }\n","    for comparison in deltas:\n","        results[\"paired_differences\"][comparison] = {\n","            metric_name: {\n","                \"point\": point_metrics[comparison_systems[comparison][0]][metric_name]\n","                - point_metrics[comparison_systems[comparison][1]][metric_name],\n","                \"ci_95pct\": _bootstrap_ci(deltas[comparison][metric_name]),\n","            }\n","            for metric_name in metric_names\n","        }\n","    (output_dir / \"distill_test_metrics.json\").write_text(\n","        json.dumps(results, indent=2, allow_nan=True), encoding=\"utf-8\"\n","    )\n","    rows = []\n","    for label in LABELS:\n","        row = {\"label\": label}\n","        for system in systems:\n","            for metric_name in (\"auprc\", \"f1\", \"auroc\", \"support\"):\n","                row[f\"{system}_{metric_name}\"] = per_class_metrics[system][label][metric_name]\n","        rows.append(row)\n","    pd.DataFrame(rows).to_csv(output_dir / \"distill_per_class_test_metrics.csv\", index=False)\n","    print(\"\\nTest metrics:\")\n","    print(pd.DataFrame(point_metrics).T.round(4).to_string())\n","    print(\"\\nPaired macro-AUROC differences (student minus baseline/teacher):\")\n","    for comparison, values in results[\"paired_differences\"].items():\n","        print(f\"{comparison}: {values['macro_auroc']}\")\n","    print(f\"Saved final test evaluation to {output_dir}\")\n","\n","\n","def parse_args():\n","    parser = argparse.ArgumentParser(description=__doc__)\n","    parser.add_argument(\"--input-dir\", default=\"/kaggle/input\")\n","    parser.add_argument(\"--data-root\", default=None)\n","    parser.add_argument(\n","        \"--output-dir\", default=\"/kaggle/working/distill/resnet50_biovil_t\"\n","    )\n","    parser.add_argument(\n","        \"--skip-teacher\",\n","        action=\"store_true\",\n","        help=\"Reuse a previously saved go/no-go and soft-label output in output-dir.\",\n","    )\n","    parser.add_argument(\n","        \"--skip-student\",\n","        action=\"store_true\",\n","        help=\"Skip student training and evaluate an existing student run.\",\n","    )\n","    parser.add_argument(\n","        \"--skip-evaluation\",\n","        action=\"store_true\",\n","        help=\"Stop after training; do not evaluate test metrics.\",\n","    )\n","    args, unknown = parser.parse_known_args()\n","    kernel_entrypoi